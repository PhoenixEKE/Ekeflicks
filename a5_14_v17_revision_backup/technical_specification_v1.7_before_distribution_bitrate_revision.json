  "version": "1.7",
  "title": "Cahier des charges technique — Spécifications pour la livraison des assets",
  "is_published": true,
  "published_at": "2026-09-07T18:55:55.206810+00:00",
  "sections": [
    {
      "key": "principles",
      "items": [
        {
          "label": "Niveaux de livraison",
          "value": "EKEFLICKS accepte trois niveaux : Master Premium, Master Standard et Master Distribution."
        },
        {
          "label": "HDR",
          "value": "Le HDR n'est obligatoire que lorsqu'un master HDR est livré ou spécifiquement demandé."
        },
        {
          "label": "Audio multicanal",
          "value": "5.1 ou 7.1 si disponible. Une piste stéréo conforme reste acceptée lorsque le master ne comporte pas de multicanal."
        },
        {
          "label": "Sous-titres et doublages",
          "value": "Les sous-titres multilingues et pistes de doublage sont livrés lorsqu'ils existent ou sont contractuellement requis."
        },
        {
          "label": "Validation",
          "value": "EKEFLICKS peut effectuer des contrôles automatiques et manuels avant validation définitive."
        }
      ],
      "title": "1. Principes généraux de livraison",
      "description": "Les fichiers livrés doivent correspondre au meilleur master professionnel disponible. Les brouillons peuvent être incomplets, mais la soumission finale doit respecter les exigences applicables."
    },
    {
      "key": "poster",
      "items": [
        {
          "label": "Ratio",
          "value": "2:3 exact.",
          "required": true,
          "rule_key": "poster.aspect_ratio",
          "auto_validation": true
        },
        {
          "label": "Résolution minimale",
          "value": "1000 × 1500 pixels.",
          "required": true,
          "rule_key": "poster.min_resolution",
          "auto_validation": true
        },
        {
          "label": "Résolution recommandée",
          "value": "3000 × 4500 pixels."
        },
        {
          "label": "Poids maximal",
          "value": "20 Mo.",
          "required": true,
          "rule_key": "poster.max_size_mb",
          "auto_validation": true
        },
        {
          "label": "Formats",
          "value": "PNG ou JPG/JPEG en qualité maximale.",
          "required": true,
          "rule_key": "poster.formats",
          "auto_validation": true
        },
        {
          "label": "Espace colorimétrique",
          "value": "RGB."
        },
        {
          "label": "Titre",
          "value": "Le titre localisé de l'œuvre peut apparaître."
        },
        {
          "label": "Éléments interdits",
          "value": "Bordures, logos DVD/Blu-ray, logos de plateformes concurrentes, texte promotionnel ou dates de sortie."
        },
        {
          "label": "Zone de sécurité",
          "value": "Conserver les informations essentielles dans une zone de sécurité d'environ 10 % autour des bords."
        }
      ],
      "title": "2. Poster",
      "description": "Affiche principale verticale utilisée dans le catalogue EKEFLICKS."
    },
    {
      "key": "banner",
      "items": [
        {
          "label": "Ratio",
          "value": "16:9 exact.",
          "required": true,
          "rule_key": "banner.aspect_ratio",
          "auto_validation": true
        },
        {
          "label": "Résolution minimale",
          "value": "1920 × 1080 pixels.",
          "required": true,
          "rule_key": "banner.min_resolution",
          "auto_validation": true
        },
        {
          "label": "Résolution recommandée",
          "value": "3840 × 2160 pixels."
        },
        {
          "label": "Poids maximal",
          "value": "10 Mo.",
          "required": true,
          "rule_key": "banner.max_size_mb",
          "auto_validation": true
        },
        {
          "label": "Formats",
          "value": "PNG ou JPG/JPEG.",
          "required": true,
          "rule_key": "banner.formats",
          "auto_validation": true
        },
        {
          "label": "Espace colorimétrique",
          "value": "RGB."
        },
        {
          "label": "Texte",
          "value": "Éviter les textes localisés intégrés au visuel, sauf validation éditoriale spécifique."
        },
        {
          "label": "Éléments interdits",
          "value": "Logos de plateformes concurrentes."
        },
        {
          "label": "Composition",
          "value": "Les personnages, visages et éléments clés doivent rester dans la zone centrale de sécurité."
        }
      ],
      "title": "3. Bannière",
      "description": "Visuel horizontal principal utilisé dans les interfaces éditoriales EKEFLICKS."
