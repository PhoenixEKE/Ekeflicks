def _producer_contract_account(user):
    if not getattr(user, 'is_producer', False):
        raise exceptions.PermissionDenied(
            'Un compte producteur est requis.'
        )

    account = getattr(user, 'producer_account', None)

    if account is None:
        raise exceptions.NotFound(
            'Compte producteur introuvable.'
        )

    return account


def _agreement_document_url(
    request,
    *,
    version=None,
    signed=False,
    download=False,
):
    url = request.build_absolute_uri(
        '/api/v1/auth/producer/agreement/document/'
    )

    params = []

    if version:
        params.append(
            'version=' + quote(str(version), safe='')
        )

    if signed:
        params.append('signed=1')

    if download:
        params.append('download=1')

    if params:
        return f"{url}?{'&'.join(params)}"

    return url


def _replace_presented_document(agreement, contract):
    storage = storages['producer_contracts']

    if agreement.presented_document_key:
        try:
            storage.delete(agreement.presented_document_key)
        except Exception:
            pass

    key = store_presented_contract(agreement, contract)

    agreement.presented_document_key = key
    agreement.contract_hash = contract.sha256
    agreement.effective_date = contract.effective_date

    agreement.save(
        update_fields=[
            'presented_document_key',
            'contract_hash',
            'effective_date',
            'updated_at',
        ]
    )


class ProducerAgreementCurrentView(generics.GenericAPIView):
    permission_classes = [permissions.IsAuthenticated]

    def get(self, request):
        account = _producer_contract_account(request.user)

        if not request.user.is_active:
            raise exceptions.PermissionDenied(
                'Ce compte est desactive.'
            )

        if not request.user.is_verified:
            raise exceptions.PermissionDenied(
                'Vous devez verifier votre adresse e-mail avant de consulter le contrat.'
            )

        if account.status == ProducerAccount.STATUS_ONBOARDING:
            raise exceptions.PermissionDenied(
                'Completez d abord vos informations professionnelles.'
            )

        if account.status == ProducerAccount.STATUS_SUSPENDED:
            raise exceptions.PermissionDenied(
                'Ce compte producteur est suspendu.'
            )

        if account.status == ProducerAccount.STATUS_REJECTED:
            raise exceptions.PermissionDenied(
                'Ce compte producteur a ete refuse.'
            )

        version = settings.PRODUCER_AGREEMENT_CURRENT_VERSION

        agreement = account.agreements.filter(
            contract_version=version,
        ).first()

        if agreement is None:
            agreement = ProducerAgreement.objects.create(
                producer_account=account,
                contract_version=version,
                contract_title=settings.PRODUCER_AGREEMENT_TITLE,
                contract_document_url=_agreement_document_url(
                    request,
                    version=version,
                ),
                status=ProducerAgreement.STATUS_PENDING,
                signature_method=ProducerAgreement.SIGNATURE_CLICKWRAP,
                ekeflicks_signer_name=settings.EKEFLICKS_CONTRACT_SIGNER_NAME,
                ekeflicks_signer_role=settings.EKEFLICKS_CONTRACT_SIGNER_ROLE,
                ekeflicks_signed_at=timezone.now(),
            )

        if agreement.status != ProducerAgreement.STATUS_SIGNED:
            try:
                presented = generate_presented_contract(
                    account,
                    ekeflicks_signed_at=agreement.ekeflicks_signed_at,
                )
            except ProducerContractError as exc:
                raise exceptions.ValidationError(
                    {'detail': str(exc)}
                )

            # Si le profil a change depuis la dernière consultation,
            # le document présenté est remplacé par la nouvelle version.
            if (
                not agreement.presented_document_key
                or agreement.contract_hash != presented.sha256
            ):
                _replace_presented_document(
                    agreement,
                    presented,
                )

        agreement.contract_document_url = _agreement_document_url(
            request,
            version=agreement.contract_version,
        )

        if agreement.status == ProducerAgreement.STATUS_SIGNED:
            agreement.signed_document_url = _agreement_document_url(
                request,
                version=agreement.contract_version,
                download=True,
            )

        agreement.save(
            update_fields=[
                'contract_document_url',
                'signed_document_url',
                'updated_at',
            ]
        )

        return Response(
            {
                'contract_version': version,
                'contract_title': agreement.contract_title,
                'contract_document_url': agreement.contract_document_url,
                'download_url': (
                    agreement.signed_document_url
                    if agreement.status == ProducerAgreement.STATUS_SIGNED
                    else agreement.contract_document_url + '?download=1'
                ),
                'contract_hash': agreement.contract_hash,
                'status': agreement.status,
                'signed_at': agreement.signed_at,
                'agreement': ProducerAgreementSerializer(agreement).data,
            },
            status=status.HTTP_200_OK,
        )


class ProducerAgreementDocumentView(generics.GenericAPIView):
    permission_classes = [permissions.IsAuthenticated]

    def get(self, request):
        account = _producer_contract_account(request.user)

        requested_version = (
            request.query_params.get('version') or ''
        ).strip()

        signed_requested = (
            request.query_params.get('signed') or ''
        ).strip().lower() in {
            '1',
            'true',
            'yes',
        }

        # -------------------------------------------------
        # Version explicite demandee.
        #
        # La requete reste toujours limitee aux contrats du
        # compte Producteur authentifie.
        # -------------------------------------------------
        if requested_version:
            if (
                len(requested_version) > 64
                or any(
                    char not in (
                        'abcdefghijklmnopqrstuvwxyz'
                        'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
                        '0123456789._-'
                    )
                    for char in requested_version
                )
            ):
                raise exceptions.ValidationError(
                    'Version de contrat invalide.'
                )

            agreement = account.agreements.filter(
                contract_version=requested_version,
            ).first()

        # -------------------------------------------------
        # Dernier contrat signe encore reconnu.
        # Permet notamment a un Producteur v1 de continuer
        # a telecharger son contrat apres activation de v2.
        # -------------------------------------------------
        elif signed_requested:
            agreement = account.agreements.filter(
                contract_version__in=(
                    settings.PRODUCER_AGREEMENT_ACCEPTED_VERSIONS
                ),
                status=ProducerAgreement.STATUS_SIGNED,
                signed_at__isnull=False,
                signed_document_key__isnull=False,
            ).exclude(
                signed_document_key='',
            ).order_by(
                '-signed_at',
                '-created_at',
            ).first()

        # -------------------------------------------------
        # Comportement normal :
        # document de la version contractuelle courante.
        # -------------------------------------------------
        else:
            agreement = account.agreements.filter(
                contract_version=(
                    settings.PRODUCER_AGREEMENT_CURRENT_VERSION
                ),
            ).first()

        if agreement is None:
            raise exceptions.NotFound(
                'Contrat producteur introuvable.'
            )

        if (
            agreement.status == ProducerAgreement.STATUS_SIGNED
            and agreement.signed_document_key
        ):
            key = agreement.signed_document_key
            suffix = 'signe'

        elif signed_requested:
            # signed=1 ne doit jamais retomber sur un document
            # simplement presente mais non signe.
            raise exceptions.NotFound(
                'Aucun contrat signe disponible.'
            )

        elif agreement.presented_document_key:
            key = agreement.presented_document_key
            suffix = 'a-signer'

        else:
            raise exceptions.NotFound(
                'Document contractuel introuvable.'
            )

        storage = storages['producer_contracts']

        if not storage.exists(key):
            raise exceptions.NotFound(
                'Document contractuel introuvable dans le stockage.'
            )

        file_obj = storage.open(key, 'rb')

        download = (
            request.query_params.get('download') or ''
        ).strip().lower() in {
            '1',
            'true',
            'yes',
        }

        filename = (
            f'contrat-producteur-ekeflicks-'
            f'{agreement.contract_version}-{suffix}.pdf'
        )

        return FileResponse(
            file_obj,
            content_type='application/pdf',
            as_attachment=download,
            filename=filename,
        )


class ProducerAgreementSignView(generics.GenericAPIView):
    serializer_class = ProducerAgreementSignSerializer
    permission_classes = [permissions.IsAuthenticated]

    def post(self, request):
        user = request.user
        account = _producer_contract_account(user)

        if not user.is_active:
            raise exceptions.PermissionDenied(
                'Ce compte est desactive.'
            )

        if not user.is_verified:
            raise exceptions.PermissionDenied(
                'Vous devez verifier votre adresse e-mail avant de signer le contrat.'
            )

        if account.status == ProducerAccount.STATUS_SUSPENDED:
            raise exceptions.PermissionDenied(
                'Ce compte producteur est suspendu.'
            )

        if account.status == ProducerAccount.STATUS_REJECTED:
            raise exceptions.PermissionDenied(
                'Ce compte producteur a ete refuse.'
            )

        if account.status == ProducerAccount.STATUS_ONBOARDING:
            raise exceptions.PermissionDenied(
                'Completez d abord vos informations professionnelles.'
            )

        serializer = self.get_serializer(data=request.data)
        serializer.is_valid(raise_exception=True)

        version = settings.PRODUCER_AGREEMENT_CURRENT_VERSION

        agreement = account.agreements.filter(
            contract_version=version,
        ).first()

        # Signature idempotente.
        if (
            agreement
            and agreement.status == ProducerAgreement.STATUS_SIGNED
            and agreement.signed_at
        ):
            return Response(
                {
                    'agreement': ProducerAgreementSerializer(
                        agreement
                    ).data,
                    'producer_account': ProducerAccountSerializer(
                        account,
                        context={'request': request},
                    ).data,
                },
                status=status.HTTP_200_OK,
            )

        if agreement is None or not agreement.presented_document_key:
            raise exceptions.ValidationError(
                {
                    'detail': (
                        'Consultez d abord le contrat personnalisé '
                        'avant de le signer.'
                    )
                }
            )

        # Vérifie que les informations Producteur n'ont pas changé
        # depuis le PDF effectivement présenté.
        try:
            current_presented = generate_presented_contract(
                account,
                ekeflicks_signed_at=agreement.ekeflicks_signed_at,
            )
        except ProducerContractError as exc:
            raise exceptions.ValidationError(
                {'detail': str(exc)}
            )

        if current_presented.sha256 != agreement.contract_hash:
            _replace_presented_document(
                agreement,
                current_presented,
            )

            return Response(
                {
                    'detail': (
                        'Vos informations professionnelles ont change. '
                        'Un nouveau contrat a ete genere. '
                        'Veuillez le relire avant de signer.'
                    ),
                    'contract_document_url': _agreement_document_url(
                        request,
                        version=agreement.contract_version,
                    ),
                },
                status=status.HTTP_409_CONFLICT,
            )

        storage = storages['producer_contracts']

        if not storage.exists(agreement.presented_document_key):
            raise exceptions.ValidationError(
                {
                    'detail': (
                        'Le document présenté est indisponible. '
                        'Rechargez la page du contrat.'
                    )
                }
            )

        with storage.open(
            agreement.presented_document_key,
            'rb',
        ) as source:
            presented_bytes = source.read()

        import hashlib

        actual_presented_hash = hashlib.sha256(
            presented_bytes
        ).hexdigest()

        if actual_presented_hash != agreement.contract_hash:
            raise exceptions.ValidationError(
                {
                    'detail': (
                        'L integrite du contrat présenté '
                        'ne peut pas etre confirmee.'
                    )
                }
            )

        presented_contract = GeneratedProducerContract(
            pdf_bytes=presented_bytes,
            sha256=agreement.contract_hash,
            effective_date=agreement.effective_date,
        )

        now = timezone.now()

        final_contract = generate_signed_contract(
            account,
            presented_contract=presented_contract,
            signed_at=now,
            ekeflicks_signed_at=agreement.ekeflicks_signed_at,
        )

        # Le PDF final est stocké avant activation du compte.
        # Si la transaction DB échoue ensuite, l'objet B2 sera supprimé.
        signed_key = store_signed_contract(
            agreement,
            final_contract,
        )

        ip_address = (
            request.META.get('HTTP_CF_CONNECTING_IP')
            or request.META.get('REMOTE_ADDR')
        )

        try:
            with transaction.atomic():
                agreement = ProducerAgreement.objects.select_for_update().get(
                    pk=agreement.pk
                )

                agreement.contract_title = settings.PRODUCER_AGREEMENT_TITLE
                agreement.contract_document_url = _agreement_document_url(
                    request,
                    version=agreement.contract_version,
                )
                agreement.status = ProducerAgreement.STATUS_SIGNED

                # Identité exclusivement issue du serveur.
                agreement.signer_name = account.representative_name.strip()
                agreement.signer_role = account.representative_role.strip()

                agreement.signature_method = (
                    ProducerAgreement.SIGNATURE_CLICKWRAP
                )
                agreement.accepted_at = now
                agreement.signed_at = now
                agreement.ip_address = ip_address
                agreement.user_agent = request.META.get(
                    'HTTP_USER_AGENT',
                    '',
                )[:2000]

                # Snapshot juridique immuable.
                agreement.producer_legal_name = account.legal_name.strip()
                agreement.producer_legal_form = account.legal_form.strip()
                agreement.producer_country_code = account.country_code.strip().upper()
                agreement.producer_address = account.address.strip()
                agreement.producer_city = (account.city or '').strip()
                agreement.producer_registration_number = (
                    account.registration_number.strip()
                )
                agreement.producer_tax_number = (
                    account.tax_number or ''
                ).strip()
                agreement.producer_representative_name = (
                    account.representative_name.strip()
                )
                agreement.producer_representative_role = (
                    account.representative_role.strip()
                )

                agreement.signed_document_key = signed_key
                agreement.signed_document_url = _agreement_document_url(
                    request,
                    version=agreement.contract_version,
                    download=True,
                )
                agreement.signed_document_hash = final_contract.sha256

                agreement.ekeflicks_signer_name = (
                    settings.EKEFLICKS_CONTRACT_SIGNER_NAME
                )
                agreement.ekeflicks_signer_role = (
                    settings.EKEFLICKS_CONTRACT_SIGNER_ROLE
                )

                agreement.save()

                if account.status == ProducerAccount.STATUS_CONTRACT_PENDING:
                    account.status = ProducerAccount.STATUS_ACTIVE
                    account.activated_at = now
                    account.save(
                        update_fields=[
                            'status',
                            'activated_at',
                            'updated_at',
                        ]
                    )

        except Exception:
            try:
                storages['producer_contracts'].delete(signed_key)
            except Exception:
                pass
            raise

        return Response(
            {
                'agreement': ProducerAgreementSerializer(
                    agreement
                ).data,
                'producer_account': ProducerAccountSerializer(
                    account,
                    context={'request': request},
                ).data,
                'download_url': agreement.signed_document_url,
            },
            status=status.HTTP_200_OK,
        )

