class ProducerRegisterSerializer(serializers.Serializer):
    """
    Dedicated EKEFLICKS producer registration.

    The producer role is assigned exclusively by the backend.
    """

    email = serializers.EmailField(required=True)
    password = serializers.CharField(
        write_only=True,
        min_length=8,
        trim_whitespace=False,
    )

    firstname = serializers.CharField(max_length=100)
    lastname = serializers.CharField(max_length=100)

    phone = serializers.CharField(
        required=False,
        allow_blank=True,
    )

    country_code = serializers.CharField(
        max_length=2,
        required=True,
    )

    company_name = serializers.CharField(max_length=255)

    def validate_email(self, value):
        email = value.strip().lower()

        if User.objects.filter(email__iexact=email).exists():
            raise serializers.ValidationError(
                'Cette adresse email est déjà utilisée.'
            )

        return email

    def validate_phone(self, value):
        if not value:
            return ''

        phone = normalize_phone(value)

        if User.objects.filter(phone=phone).exists():
            raise serializers.ValidationError(
                'Ce numéro de téléphone est déjà utilisé.'
            )

        return phone

    def validate_country_code(self, value):
        code = value.strip().upper()

        if len(code) != 2 or not code.isalpha():
            raise serializers.ValidationError(
                'Utilisez un code pays ISO a 2 lettres, par exemple CI, FR ou BF.'
            )

        return code

    def validate_company_name(self, value):
        value = value.strip()

        if not value:
            raise serializers.ValidationError(
                'Le nom de la societe ou structure est obligatoire.'
            )

        return value

    @transaction.atomic
    def create(self, validated_data):
        company_name = validated_data.pop('company_name')

        user = User.objects.create_user(
            email=validated_data['email'],
            password=validated_data['password'],
            firstname=validated_data.get('firstname', ''),
            lastname=validated_data.get('lastname', ''),
            phone=validated_data.get('phone', ''),
            country_code=validated_data.get('country_code', ''),
        )

        # Never trust a producer flag supplied by the client.
        user.is_producer = True
        user.producer_company = company_name
        user.save(
            update_fields=[
                'is_producer',
                'producer_company',
                'updated_at',
            ]
        )

        ProducerAccount.objects.create(
            user=user,
            company_name=company_name,
            country_code=validated_data.get('country_code', ''),
            phone=validated_data.get('phone', ''),
            representative_name=(
                f"{validated_data.get('firstname', '')} "
                f"{validated_data.get('lastname', '')}"
            ).strip(),
            status=ProducerAccount.STATUS_ONBOARDING,
        )

        return user


class ProducerAccountSerializer(serializers.ModelSerializer):
    email = serializers.EmailField(
        source='user.email',
        read_only=True,
    )

    firstname = serializers.CharField(
        source='user.firstname',
        read_only=True,
    )

    lastname = serializers.CharField(
        source='user.lastname',
        read_only=True,
    )

    email_verified = serializers.BooleanField(
        source='user.is_verified',
        read_only=True,
    )

    current_contract_version = serializers.SerializerMethodField()
    current_agreement_status = serializers.SerializerMethodField()
    can_submit_content = serializers.SerializerMethodField()

    class Meta:
        model = ProducerAccount
        fields = [
            'id',
            'email',
            'firstname',
            'lastname',
            'email_verified',
            'company_name',
            'legal_name',
            'legal_form',
            'registration_number',
            'tax_number',
            'country_code',
            'address',
            'city',
            'phone',
            'representative_name',
            'representative_role',
            'status',
            'activated_at',
            'suspended_at',
            'rejection_reason',
            'current_contract_version',
            'current_agreement_status',
            'can_submit_content',
            'created_at',
            'updated_at',
        ]

        read_only_fields = [
            'id',
            'status',
            'activated_at',
            'suspended_at',
            'rejection_reason',
            'created_at',
            'updated_at',
        ]

    def get_current_contract_version(self, obj):
        return settings.PRODUCER_AGREEMENT_CURRENT_VERSION

    def _current_agreement(self, obj):
        return obj.agreements.filter(
            contract_version=settings.PRODUCER_AGREEMENT_CURRENT_VERSION,
        ).first()

    def get_current_agreement_status(self, obj):
        agreement = self._current_agreement(obj)
        return agreement.status if agreement else 'not_signed'

    def get_can_submit_content(self, obj):
        from apps.common.permissions import is_active_producer_user
        return is_active_producer_user(obj.user)

    def update(self, instance, validated_data):
        instance = super().update(instance, validated_data)

        # The producer may access the agreement only after completing
        # all mandatory legal information. tax_number remains optional.
        if instance.status == ProducerAccount.STATUS_ONBOARDING:
            required_legal_fields = (
                instance.company_name,
                instance.legal_name,
                instance.legal_form,
                instance.country_code,
                instance.address,
                instance.registration_number,
                instance.representative_name,
                instance.representative_role,
            )

            if all(
                isinstance(value, str) and value.strip()
                for value in required_legal_fields
            ):
                instance.status = ProducerAccount.STATUS_CONTRACT_PENDING
                instance.save(
                    update_fields=[
                        'status',
                        'updated_at',
                    ]
                )

        return instance


