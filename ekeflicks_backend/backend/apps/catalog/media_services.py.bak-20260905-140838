from rest_framework import serializers

from apps.common.media_storage import (
    dated_path,
    object_id,
    save_internal_upload,
    safe_extension,
)


CONTENT_MEDIA_CONFIG = {
    'poster': {
        'temp_field': 'poster_temp_path',
        'final_field': 'poster_url',
        'storage_alias': 'final_posters',
        'cdn_prefix': 'posters',
        'default_extension': '.jpg',
        'allowed_extensions': {'.jpg', '.jpeg', '.png', '.webp'},
        'final_name': 'poster',
    },
    'backdrop': {
        'temp_field': 'backdrop_temp_path',
        'final_field': 'backdrop_url',
        'storage_alias': 'final_backdrops',
        'cdn_prefix': 'backdrops',
        'default_extension': '.jpg',
        'allowed_extensions': {'.jpg', '.jpeg', '.png', '.webp'},
        'final_name': 'backdrop',
    },
    'trailer': {
        'temp_field': 'trailer_temp_path',
        'final_field': 'trailer_url',
        'storage_alias': 'final_trailers',
        'cdn_prefix': 'trailers',
        'default_extension': '.mp4',
        'allowed_extensions': {'.mp4', '.m4v', '.mov', '.webm'},
        'final_name': 'trailer',
    },
}


def store_content_media_temp(content, uploaded_file, media_type, uploader=None):
    """
    Stocke un média producteur uniquement dans MinIO TEMP.

    Aucune copie B2/CDN n'est réalisée ici.
    Les champs *_url restent réservés au média FINAL après validation admin.
    """
    try:
        config = CONTENT_MEDIA_CONFIG[media_type]
    except KeyError as exc:
        raise serializers.ValidationError(
            {'media_type': 'Type de média non supporté.'}
        ) from exc

    extension = safe_extension(
        getattr(uploaded_file, 'name', ''),
        config['default_extension'],
    )

    if extension not in config['allowed_extensions']:
        raise serializers.ValidationError({
            'file': f"Extension non autorisée pour {media_type}: {extension}"
        })

    producer_id = object_id(uploader)
    internal_path = (
        f"uploads/producer_{producer_id}/"
        f"{dated_path()}/"
        f"content_{content.id}/"
        f"{media_type}_original{extension}"
    )

    saved_path = save_internal_upload(
        uploaded_file=uploaded_file,
        storage_path=internal_path,
    )

    temp_field = config['temp_field']
    final_field = config['final_field']

    setattr(content, temp_field, saved_path)

    # Un remplacement de média TEMP invalide toute ancienne référence FINAL
    # présente sur le brouillon.
    setattr(content, final_field, '')

    content.save(update_fields=[
        temp_field,
        final_field,
        'updated_at',
    ])

    return {
        'media_type': media_type,
        'field': temp_field,
        'temporary_path': saved_path,
        'final_field': final_field,
        'url': '',
        'storage': 'temporary',
    }
