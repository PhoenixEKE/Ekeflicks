from unittest.mock import patch

from django.test import SimpleTestCase

from apps.streaming.tasks import (
    _probe_frame_timing,
)


class _FakePipe:
    def __init__(self, lines):
        self._lines = iter(lines)

    def __iter__(self):
        return self

    def __next__(self):
        return next(self._lines)

    def close(self):
        pass

    def read(self):
        return ""


class _FakeProcess:
    def __init__(
        self,
        lines,
        returncode=0,
    ):
        self.stdout = _FakePipe(lines)
        self.stderr = _FakePipe([])
        self._returncode = returncode

    def wait(self, timeout=None):
        return self._returncode

    def poll(self):
        return self._returncode

    def kill(self):
        self._returncode = -9


class FrameTimingProbeTests(
    SimpleTestCase
):
    def _run(self, timestamps):
        lines = (
            f"{value},{value}\n"
            for value in timestamps
        )

        process = _FakeProcess(lines)

        with patch(
            "apps.streaming.tasks."
            "subprocess.Popen",
            return_value=process,
        ) as mocked:
            result = _probe_frame_timing(
                "/tmp/master.mp4"
            )

        command = mocked.call_args.args[0]

        self.assertIn(
            "-show_frames",
            command,
        )
        self.assertIn(
            "csv=p=0",
            command,
        )
        self.assertNotIn(
            "json",
            command,
        )

        return result

    def test_cfr_is_preserved(self):
        timestamps = [
            index * 0.04
            for index in range(1000)
        ]

        result = self._run(
            timestamps
        )

        self.assertTrue(
            result["available"]
        )
        self.assertTrue(
            result["is_constant"]
        )
        self.assertEqual(
            result["frame_count"],
            1000,
        )
        self.assertEqual(
            result[
                "median_delta_seconds"
            ],
            0.04,
        )

    def test_vfr_is_preserved(self):
        timestamps = [0.0]

        for index in range(
            1,
            1000,
        ):
            step = (
                0.08
                if index == 500
                else 0.04
            )

            timestamps.append(
                timestamps[-1] + step
            )

        result = self._run(
            timestamps
        )

        self.assertTrue(
            result["available"]
        )
        self.assertFalse(
            result["is_constant"]
        )
        self.assertEqual(
            result[
                "median_delta_seconds"
            ],
            0.04,
        )

    def test_report_timestamps_are_bounded(
        self
    ):
        timestamps = [
            index * 0.04
            for index in range(2000)
        ]

        result = self._run(
            timestamps
        )

        self.assertEqual(
            result["frame_count"],
            2000,
        )
        self.assertEqual(
            len(
                result["timestamps"]
            ),
            500,
        )
        self.assertTrue(
            result[
                "timestamps_truncated"
            ]
        )

    def test_exact_even_median_is_preserved(
        self
    ):
        timestamps = [
            0.0,
            0.04,
            0.08,
            0.14,
            0.20,
        ]

        result = self._run(
            timestamps
        )

        self.assertEqual(
            result[
                "median_delta_seconds"
            ],
            0.05,
        )

    def test_invalid_or_insufficient_data(
        self
    ):
        result = self._run(
            [0.0, 0.04]
        )

        self.assertFalse(
            result["available"]
        )
        self.assertIsNone(
            result["is_constant"]
        )
        self.assertEqual(
            result["frame_count"],
            2,
        )

    def test_large_input_crosses_chunk_boundary(
        self
    ):
        timestamps = [
            index * 0.04
            for index in range(50010)
        ]

        result = self._run(
            timestamps
        )

        self.assertTrue(
            result["available"]
        )
        self.assertTrue(
            result["is_constant"]
        )
        self.assertEqual(
            result["frame_count"],
            50010,
        )
        self.assertEqual(
            len(
                result["timestamps"]
            ),
            500,
        )


class FrameTimingTimeoutTests(
    SimpleTestCase
):
    def test_process_uses_devnull_for_stderr(
        self
    ):
        process = _FakeProcess(
            [
                "0.0,0.0\n",
                "0.04,0.04\n",
                "0.08,0.08\n",
            ]
        )

        with patch(
            "apps.streaming.tasks."
            "subprocess.Popen",
            return_value=process,
        ) as mocked:
            result = _probe_frame_timing(
                "/tmp/master.mp4"
            )

        self.assertTrue(
            result["available"]
        )

        self.assertIs(
            mocked.call_args.kwargs[
                "stderr"
            ],
            __import__(
                "subprocess"
            ).DEVNULL,
        )
