from rest_framework import serializers

from .social_models import SocialProfile


class PublicSocialProfileSerializer(
    serializers.ModelSerializer
):
    user_id = serializers.UUIDField(
        source="profile.user_id",
        read_only=True,
    )

    profile_id = serializers.UUIDField(
        source="profile_id",
        read_only=True,
    )

    display_name = serializers.CharField(
        source="public_display_name",
        read_only=True,
    )

    avatar_url = serializers.CharField(
        source="profile.avatar_url",
        read_only=True,
        allow_blank=True,
    )

    class Meta:
        model = SocialProfile
        fields = (
            "user_id",
            "profile_id",
            "display_name",
            "avatar_url",
            "bio",
        )


class OwnSocialProfileSerializer(
    serializers.ModelSerializer
):
    user_id = serializers.UUIDField(
        source="profile.user_id",
        read_only=True,
    )

    profile_id = serializers.UUIDField(
        source="profile_id",
        read_only=True,
    )

    avatar_url = serializers.CharField(
        source="profile.avatar_url",
        read_only=True,
        allow_blank=True,
    )

    class Meta:
        model = SocialProfile
        fields = (
            "user_id",
            "profile_id",
            "display_name",
            "avatar_url",
            "bio",
            "is_discoverable",
            "created_at",
            "updated_at",
        )

        read_only_fields = (
            "user_id",
            "profile_id",
            "avatar_url",
            "created_at",
            "updated_at",
        )

    def validate_display_name(self, value):
        return value.strip()

    def validate_bio(self, value):
        return value.strip()
