class SubscriptionPlanSerializer(serializers.ModelSerializer):
    market_zone = serializers.SerializerMethodField()
    tv_enabled = serializers.SerializerMethodField()

    REGIONAL_FIELDS = {
        'price',
        'currency',
        'duration_days',
        'max_profiles',
        'max_devices',
        'max_quality',
        'ads_included',
        'download_enabled',
        'features',
        'display_order',
    }

    class Meta:
        model = SubscriptionPlan
        fields = [
            'id',
            'name',
            'slug',
            'description',
            'price',
            'currency',
            'duration_days',
            'max_profiles',
            'max_devices',
            'max_quality',
            'ads_included',
            'download_enabled',
            'tv_enabled',
            'features',
            'display_order',
            'market_zone',
            'is_active',
            'created_at',
            'updated_at',
        ]
        read_only_fields = [
            'id',
            'market_zone',
            'tv_enabled',
            'created_at',
            'updated_at',
        ]

    def _country_code(self):
        request = self.context.get('request')
        user = getattr(request, 'user', None)

        if user and user.is_authenticated:
            return getattr(user, 'country_code', '')

        return ''

    def _regional_offer(self, obj):
        return resolve_plan_offer(
            obj,
            self._country_code(),
        )

    def get_market_zone(self, obj):
        return resolve_market_zone(
            self._country_code(),
        )

    def get_tv_enabled(self, obj):
        offer = self._regional_offer(obj)
        return offer.tv_enabled if offer else False

    def to_representation(self, instance):
        data = super().to_representation(instance)

        offer = self._regional_offer(instance)

        if not offer:
            return data

        for field in self.REGIONAL_FIELDS:
            value = getattr(offer, field)

            if field == 'price':
                value = str(value)

            data[field] = value

        return data


class SubscriptionSerializer(serializers.ModelSerializer):
    plan = SubscriptionPlanSerializer(read_only=True)
    plan_id = serializers.PrimaryKeyRelatedField(
        source='plan',
        queryset=SubscriptionPlan.objects.filter(is_active=True),
        write_only=True,
    )

    class Meta:
        model = Subscription
        fields = [
            'id',
            'plan',
            'plan_id',
            'status',
            'started_at',
            'expires_at',
            'cancelled_at',
            'auto_renew',
            'created_at',
            'updated_at',
        ]
        read_only_fields = [
            'id',
            'plan',
            'status',
            'started_at',
            'expires_at',
            'cancelled_at',
            'created_at',
            'updated_at',
        ]

    def create(self, validated_data):
        user = get_request_user(self)

        if not user or not user.is_authenticated:
            raise serializers.ValidationError(
                "Authentification requise."
            )

        plan = validated_data['plan']
        country_code = getattr(user, 'country_code', '')

        market_zone = resolve_market_zone(country_code)
        offer = resolve_plan_offer(plan, country_code)

        if offer:
            price = offer.price
            currency = offer.currency
            duration_days = offer.duration_days
            max_profiles = offer.max_profiles
            max_devices = offer.max_devices
            max_quality = offer.max_quality
            ads_included = offer.ads_included
            download_enabled = offer.download_enabled
            tv_enabled = offer.tv_enabled
            features = offer.features
        else:
            # Compatibilite temporaire avec les anciens plans globaux.
            price = plan.price
            currency = plan.currency
            duration_days = plan.duration_days
            max_profiles = plan.max_profiles
            max_devices = plan.max_devices
            max_quality = plan.max_quality
            ads_included = plan.ads_included
            download_enabled = plan.download_enabled
            tv_enabled = False
            features = plan.features

        expires_at = (
            timezone.now()
            + timedelta(days=duration_days)
        )

        is_free = price == 0

        return Subscription.objects.create(
            user=user,
            plan=plan,
            regional_offer=offer,
            market_zone=market_zone,
            price_at_purchase=price,
            currency_at_purchase=currency,
            duration_days_at_purchase=duration_days,
            max_profiles_at_purchase=max_profiles,
            max_devices_at_purchase=max_devices,
            max_quality_at_purchase=max_quality,
            ads_included_at_purchase=ads_included,
            download_enabled_at_purchase=download_enabled,
            tv_enabled_at_purchase=tv_enabled,
            features_at_purchase=features,
            status='active' if is_free else 'pending',
            expires_at=expires_at,
            auto_renew=(
                False
                if is_free
                else validated_data.get('auto_renew', True)
            ),
        )


class PaymentSerializer(serializers.ModelSerializer):
    subscription = SubscriptionSerializer(read_only=True)
    subscription_id = serializers.PrimaryKeyRelatedField(
        source='subscription',
        queryset=Subscription.objects.all(),
        write_only=True,
    )

    class Meta:
        model = Payment
        fields = [
            'id',
            'subscription',
            'subscription_id',
            'amount',
            'currency',
            'status',
            'provider',
            'provider_payment_id',
            'provider_reference',
            'checkout_url',
            'metadata',
            'provider_payload',
            'verified_at',
            'paid_at',
            'created_at',
            'updated_at',
        ]
        read_only_fields = [
            'id',
            'subscription',
            'amount',
            'currency',
            'status',
            'provider_reference',
            'checkout_url',
            'provider_payment_id',
            'provider_payload',
            'verified_at',
            'paid_at',
            'created_at',
            'updated_at',
        ]

    def validate_subscription_id(self, subscription):
        user = get_request_user(self)
        if not user or not user.is_authenticated or subscription.user_id != user.id:
            raise serializers.ValidationError("Abonnement invalide pour cet utilisateur.")
        return subscription

    def create(self, validated_data):
        subscription = validated_data['subscription']
        plan = subscription.plan
        provider = (validated_data.get('provider') or 'cinetpay').lower()
        provider_reference = f"eke_{uuid.uuid4().hex}"

        payment = Payment.objects.create(
            subscription=subscription,
            amount=plan.price,
            currency=plan.currency,
            status='pending',
            provider=provider,
            provider_reference=provider_reference,
            metadata={
                'subscription_id': str(subscription.id),
                'plan_id': str(plan.id),
            },
        )

        if provider != 'stripe':
            return payment

        if not settings.STRIPE_SECRET_KEY:
            raise serializers.ValidationError(
                {'provider': 'Stripe n est pas configure sur le serveur.'}
            )

        stripe.api_key = settings.STRIPE_SECRET_KEY

        currency = str(plan.currency).lower()

        # Stripe attend le montant dans la plus petite unite monetaire.
        # Les devises suivantes sont sans decimales chez Stripe.
        zero_decimal_currencies = {
            'bif', 'clp', 'djf', 'gnf', 'jpy', 'kmf',
            'krw', 'mga', 'pyg', 'rwf', 'ugx', 'vnd',
            'vuv', 'xaf', 'xof', 'xpf',
        }

        if currency in zero_decimal_currencies:
            unit_amount = int(Decimal(plan.price))
        else:
            unit_amount = int(Decimal(plan.price) * 100)

        success_url = (
            f"{settings.PAYMENT_RETURN_URL}"
            "?status=success&session_id={CHECKOUT_SESSION_ID}"
        )
        cancel_url = (
            f"{settings.PAYMENT_RETURN_URL}"
            "?status=cancelled"
        )

        try:
            session = stripe.checkout.Session.create(
                mode='payment',
                client_reference_id=provider_reference,
                customer_email=subscription.user.email,
                success_url=success_url,
                cancel_url=cancel_url,
                line_items=[
                    {
                        'price_data': {
                            'currency': currency,
                            'product_data': {
                                'name': f"EKEFLICKS - {plan.name}",
                            },
                            'unit_amount': unit_amount,
                        },
                        'quantity': 1,
                    }
                ],
                metadata={
                    'payment_id': str(payment.id),
                    'subscription_id': str(subscription.id),
                    'plan_id': str(plan.id),
                    'provider_reference': provider_reference,
                },
            )
        except stripe.StripeError as exc:
            raise serializers.ValidationError(
                {'provider': f'Impossible d initialiser Stripe: {str(exc)}'}
            )

        payment.provider_payment_id = session.id
        payment.checkout_url = session.url or ''
        payment.provider_payload = {
            'checkout_session_id': session.id,
        }
        payment.save(
            update_fields=[
                'provider_payment_id',
                'checkout_url',
                'provider_payload',
                'updated_at',
            ]
        )

        return payment


