    def test_same_profile_not_double_counted(
        self,
    ):
        client = Mock()

        client.query.return_value = (
            self._result(
                [
                    (
                        'UTC',
                        date(
                            2026,
                            1,
                            15,
                        ),
                        8,
                        self.profile_a,
                        2,
                    ),
                    (
                        'UTC',
                        date(
                            2026,
                            1,
                            16,
                        ),
                        8,
                        self.profile_a,
                        3,
                    ),
                ]
            )
        )

        result = (
            audience_hourly_activity(
                start_at=self.start_at,
                end_at=self.end_at,
                client=client,
            )
        )

        self.assertEqual(
            result[8][
                'active_profiles'
            ],
            1,
        )

        self.assertEqual(
            result[8][
                'events'
            ],
            5,
        )

    def test_country_filter(
        self,
    ):
        client = Mock()

        client.query.return_value = (
            self._result([])
        )

        audience_hourly_activity(
            start_at=self.start_at,
            end_at=self.end_at,
            country_code='ci',
            client=client,
        )

        call = (
            client
            .query
            .call_args
        )

        self.assertEqual(
            call
            .kwargs[
                'parameters'
            ][
                'country_code'
            ],
            'CI',
        )

    @patch(
        'apps.analytics.services.'
        'audience_hourly_activity'
    )
    def test_peak_ranking(
        self,
        hourly,
    ):
        hourly.return_value = [
            {
                'hour': 8,
                'active_profiles': 5,
                'events': 10,
            },
            {
                'hour': 20,
                'active_profiles': 12,
                'events': 18,
            },
            {
                'hour': 21,
                'active_profiles': 12,
                'events': 25,
            },
        ]

        result = (
            audience_peak_hours(
                start_at=self.start_at,
                end_at=self.end_at,
                limit=2,
                client=Mock(),
            )
        )

        self.assertEqual(
            result[0]['hour'],
            21,
        )

        self.assertEqual(
            result[1]['hour'],
            20,
        )

    def test_country_peaks_respect_dst(
        self,
    ):
        client = Mock()

        client.query.return_value = (
            self._result(
                [
                    (
                        'CI',
                        'Africa/Abidjan',
                        date(
                            2026,
                            7,
                            15,
                        ),
                        18,
                        self.profile_a,
                        4,
                    ),
                    (
                        'FR',
                        'Europe/Paris',
                        date(
                            2026,
                            7,
                            15,
                        ),
                        18,
                        self.profile_b,
                        6,
                    ),
                ]
            )
        )

        result = (
            audience_peak_hours_by_country(
                start_at=self.start_at,
                end_at=self.end_at,
                limit_per_country=1,
                client=client,
            )
        )

        self.assertEqual(
            result[0][
                'country_code'
            ],
            'CI',
        )

        self.assertEqual(
            result[0][
                'peak_hours'
            ][0][
                'hour'
            ],
            18,
        )

        self.assertEqual(
            result[1][
                'country_code'
            ],
            'FR',
        )

        self.assertEqual(
            result[1][
                'peak_hours'
            ][0][
                'hour'
            ],
            20,
        )

    def test_filters_real_audience_only(
        self,
    ):
        client = Mock()

        client.query.return_value = (
            self._result([])
        )

        audience_hourly_activity(
            start_at=self.start_at,
            end_at=self.end_at,
            client=client,
        )

        query = (
            client
            .query
            .call_args
            .args[0]
        )

        self.assertIn(
            'profile_id IS NOT NULL',
            query,
        )

        self.assertIn(
            'is_internal = 0',
            query,
        )

        self.assertIn(
            'is_test = 0',
            query,
        )

    def test_invalid_range(
        self,
    ):
        with self.assertRaises(
            ValueError
        ):
            audience_hourly_activity(
                start_at=self.end_at,
                end_at=self.start_at,
                client=Mock(),
            )

        with self.assertRaises(
            ValueError
        ):
            audience_peak_hours_by_country(
                start_at=self.end_at,
                end_at=self.start_at,
                client=Mock(),
            )
