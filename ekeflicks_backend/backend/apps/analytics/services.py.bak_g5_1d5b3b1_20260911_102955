AUDIENCE_ACTIVITY_FILTER = """
    profile_id IS NOT NULL
    AND is_internal = 0
    AND is_test = 0
"""


def audience_active_profiles(
    *,
    start_at,
    end_at,
    client=None,
):
    """
    Count distinct active profiles in [start_at, end_at).

    An active profile is a profile with at least one real analytics
    event during the requested period.

    Internal and test events are excluded.
    """
    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    result = client.query(
        f"""
        SELECT uniqExact(profile_id)
        FROM analytics_events
        WHERE
            {AUDIENCE_ACTIVITY_FILTER}
            AND occurred_at >= {{start_at:DateTime64(3)}}
            AND occurred_at < {{end_at:DateTime64(3)}}
        """,
        parameters={
            'start_at': _analytics_datetime(start_at),
            'end_at': _analytics_datetime(end_at),
        },
    )

    return int(result.result_rows[0][0])



def audience_snapshot(
    *,
    as_of,
    client=None,
):
    """
    Return calendar-aligned audience metrics as of `as_of`.

    All boundaries are UTC.

    DAU:
        unique active profiles from 00:00 UTC of the current
        calendar day until `as_of`.

    WAU:
        unique active profiles from 00:00 UTC six calendar days
        before the current day until `as_of`.

    MAU:
        unique active profiles from 00:00 UTC twenty-nine calendar
        days before the current day until `as_of`.

    Therefore WAU covers the current calendar day plus the previous
    6 calendar days, and MAU covers the current calendar day plus
    the previous 29 calendar days.

    Stickiness = DAU / MAU * 100.

    This deliberately does not use User.last_login.
    """
    from datetime import timedelta

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    end_at = _analytics_datetime(
        as_of
    )

    day_start = end_at.replace(
        hour=0,
        minute=0,
        second=0,
        microsecond=0,
    )

    dau_start = day_start

    wau_start = (
        day_start
        - timedelta(days=6)
    )

    mau_start = (
        day_start
        - timedelta(days=29)
    )

    dau = audience_active_profiles(
        start_at=dau_start,
        end_at=end_at,
        client=client,
    )

    wau = audience_active_profiles(
        start_at=wau_start,
        end_at=end_at,
        client=client,
    )

    mau = audience_active_profiles(
        start_at=mau_start,
        end_at=end_at,
        client=client,
    )

    stickiness = (
        round(
            dau * 100.0 / mau,
            2,
        )
        if mau
        else 0.0
    )

    return {
        'as_of': end_at.isoformat(),

        'timezone': 'UTC',

        'dau': dau,
        'wau': wau,
        'mau': mau,

        'stickiness_percent': (
            stickiness
        ),

        'windows': {
            'dau': {
                'start': (
                    dau_start.isoformat()
                ),
                'end': (
                    end_at.isoformat()
                ),
            },
            'wau': {
                'start': (
                    wau_start.isoformat()
                ),
                'end': (
                    end_at.isoformat()
                ),
            },
            'mau': {
                'start': (
                    mau_start.isoformat()
                ),
                'end': (
                    end_at.isoformat()
                ),
            },
        },
    }


def audience_by_dimension(
    *,
    start_at,
    end_at,
    dimension,
    client=None,
):
    """
    Count distinct active profiles by an approved analytics dimension.
    """
    allowed_dimensions = {
        'country_code',
        'profile_type',
        'platform',
        'device_type',
        'interface_language',
    }

    if dimension not in allowed_dimensions:
        raise ValueError(
            f'Unsupported audience dimension: {dimension}'
        )

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    result = client.query(
        f"""
        SELECT
            {dimension},
            uniqExact(profile_id) AS active_profiles
        FROM analytics_events
        WHERE
            {AUDIENCE_ACTIVITY_FILTER}
            AND occurred_at >= {{start_at:DateTime64(3)}}
            AND occurred_at < {{end_at:DateTime64(3)}}
        GROUP BY {dimension}
        ORDER BY
            active_profiles DESC,
            {dimension} ASC
        """,
        parameters={
            'start_at': _analytics_datetime(start_at),
            'end_at': _analytics_datetime(end_at),
        },
    )

    return [
        {
            dimension: (
                value
                if value is not None
                else ''
            ),
            'active_profiles': int(active_profiles),
        }
        for value, active_profiles
        in result.result_rows
    ]


AUDIENCE_RETENTION_DAYS = (
    1,
    3,
    7,
    14,
    30,
)



def audience_retention(
    *,
    cohort_start,
    cohort_end,
    as_of=None,
    client=None,
):
    """
    Return daily first-activity cohorts with exact-day retention.

    cohort_start is inclusive.
    cohort_end is exclusive.

    Cohort membership:
        first real analytics activity date of profile.

    D1/D3/D7/D14/D30:
        same profile has at least one real activity exactly
        N UTC calendar days after cohort_date.

    Maturity:
        a Dn metric is mature only when its complete target UTC
        calendar day has elapsed before `as_of`.

        Example:
            cohort = September 9
            D1 target = September 10

            During September 10:
                D1 is not mature.

            From September 11 00:00 UTC:
                D1 is mature.

    Immature metrics return:
        dN = None
        dN_percent = None
        dN_mature = False

    Only events strictly before `as_of` participate in the cohort
    and activity calculations.
    """
    from datetime import timedelta

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    start_date = _analytics_datetime(
        cohort_start
    ).date()

    end_date = _analytics_datetime(
        cohort_end
    ).date()

    observation_at = (
        _analytics_datetime(as_of)
    )

    observation_date = (
        observation_at.date()
    )

    if end_date <= start_date:
        raise ValueError(
            'cohort_end must be after cohort_start'
        )

    result = client.query(
        f"""
        WITH
            first_activity AS
            (
                SELECT
                    profile_id,
                    min(
                        toDate(occurred_at)
                    ) AS cohort_date

                FROM analytics_events

                WHERE
                    {AUDIENCE_ACTIVITY_FILTER}

                    AND occurred_at
                        < {{as_of:DateTime64(3)}}

                GROUP BY profile_id
            ),

            activity_days AS
            (
                SELECT DISTINCT
                    profile_id,
                    toDate(
                        occurred_at
                    ) AS activity_date

                FROM analytics_events

                WHERE
                    {AUDIENCE_ACTIVITY_FILTER}

                    AND occurred_at
                        < {{as_of:DateTime64(3)}}
            ),

            cohorts AS
            (
                SELECT
                    profile_id,
                    cohort_date

                FROM first_activity

                WHERE
                    cohort_date
                        >= {{cohort_start:Date}}

                    AND cohort_date
                        < {{cohort_end:Date}}
            )

        SELECT
            c.cohort_date,

            uniqExact(
                c.profile_id
            ) AS cohort_size,

            uniqExactIf(
                c.profile_id,
                a.activity_date =
                    addDays(
                        c.cohort_date,
                        1
                    )
            ) AS d1,

            uniqExactIf(
                c.profile_id,
                a.activity_date =
                    addDays(
                        c.cohort_date,
                        3
                    )
            ) AS d3,

            uniqExactIf(
                c.profile_id,
                a.activity_date =
                    addDays(
                        c.cohort_date,
                        7
                    )
            ) AS d7,

            uniqExactIf(
                c.profile_id,
                a.activity_date =
                    addDays(
                        c.cohort_date,
                        14
                    )
            ) AS d14,

            uniqExactIf(
                c.profile_id,
                a.activity_date =
                    addDays(
                        c.cohort_date,
                        30
                    )
            ) AS d30

        FROM cohorts AS c

        LEFT JOIN activity_days AS a
            ON c.profile_id = a.profile_id

        GROUP BY
            c.cohort_date

        ORDER BY
            c.cohort_date ASC
        """,
        parameters={
            'cohort_start': start_date,
            'cohort_end': end_date,
            'as_of': observation_at,
        },
    )

    rows = []

    for (
        cohort_date,
        cohort_size,
        d1,
        d3,
        d7,
        d14,
        d30,
    ) in result.result_rows:

        cohort_size = int(
            cohort_size
        )

        counts = {
            1: int(d1),
            3: int(d3),
            7: int(d7),
            14: int(d14),
            30: int(d30),
        }

        row = {
            'cohort_date': (
                cohort_date.isoformat()
            ),

            'cohort_size': (
                cohort_size
            ),
        }

        for day in (
            AUDIENCE_RETENTION_DAYS
        ):
            target_date = (
                cohort_date
                + timedelta(days=day)
            )

            mature = (
                target_date
                < observation_date
            )

            row[
                f'd{day}_mature'
            ] = mature

            if not mature:
                row[
                    f'd{day}'
                ] = None

                row[
                    f'd{day}_percent'
                ] = None

                continue

            count = counts[day]

            row[
                f'd{day}'
            ] = count

            row[
                f'd{day}_percent'
            ] = (
                round(
                    count
                    * 100.0
                    / cohort_size,
                    2,
                )
                if cohort_size
                else 0.0
            )

        rows.append(row)

    return rows



def audience_retention_summary(rows):
    """
    Weighted retention summary across cohort rows.

    For each Dn:
      - only mature cohorts participate in the denominator;
      - retained profiles are summed only from mature cohorts;
      - immature cohorts never become artificial 0% retention.

    Backward compatibility:
        rows without an explicit dN_mature flag are considered mature.
    """
    rows = list(
        rows or []
    )

    cohort_size = sum(
        int(
            row.get(
                'cohort_size'
            )
            or 0
        )
        for row in rows
    )

    result = {
        'cohort_size': (
            cohort_size
        ),
    }

    for day in (
        AUDIENCE_RETENTION_DAYS
    ):
        mature_rows = [
            row
            for row in rows
            if bool(
                row.get(
                    f'd{day}_mature',
                    True,
                )
            )
        ]

        eligible_profiles = sum(
            int(
                row.get(
                    'cohort_size'
                )
                or 0
            )
            for row in mature_rows
        )

        retained = sum(
            int(
                row.get(
                    f'd{day}'
                )
                or 0
            )
            for row in mature_rows
        )

        result[
            f'd{day}'
        ] = retained

        result[
            f'd{day}_eligible_profiles'
        ] = eligible_profiles

        result[
            f'd{day}_mature_cohorts'
        ] = len(
            mature_rows
        )

        result[
            f'd{day}_percent'
        ] = (
            round(
                retained
                * 100.0
                / eligible_profiles,
                2,
            )
            if eligible_profiles
            else None
        )

    return result


def audience_hourly_activity(
    *,
    start_at,
    end_at,
    country_code=None,
    client=None,
):
    """
    Return active profiles and event volume by local hour.

    ClickHouse first aggregates by:
      - event timezone
      - real UTC calendar date
      - UTC hour
      - profile

    Python then converts each aggregated bucket using its real date,
    preserving DST / summer-winter timezone transitions.

    country_code is only a filter and never determines timezone.
    """
    from collections import defaultdict
    from datetime import (
        datetime as _datetime,
        time as _time,
        timezone as _timezone,
    )
    from zoneinfo import (
        ZoneInfo,
        ZoneInfoNotFoundError,
    )

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    start_at = _analytics_datetime(start_at)
    end_at = _analytics_datetime(end_at)

    if end_at <= start_at:
        raise ValueError(
            'end_at must be after start_at'
        )

    country_code = (
        str(country_code or '')
        .strip()
        .upper()
    )

    country_filter = ""

    parameters = {
        'start_at': start_at,
        'end_at': end_at,
    }

    if country_code:
        country_filter = """
            AND country_code = {country_code:String}
        """
        parameters['country_code'] = (
            country_code
        )

    result = client.query(
        f"""
        SELECT
            if(
                timezone = '',
                'UTC',
                timezone
            ) AS event_timezone,

            toDate(
                occurred_at
            ) AS utc_date,

            toHour(
                occurred_at
            ) AS utc_hour,

            profile_id,

            count() AS events

        FROM analytics_events

        WHERE
            {AUDIENCE_ACTIVITY_FILTER}

            AND occurred_at >= {{start_at:DateTime64(3)}}

            AND occurred_at < {{end_at:DateTime64(3)}}

            {country_filter}

        GROUP BY
            event_timezone,
            utc_date,
            utc_hour,
            profile_id
        """,
        parameters=parameters,
    )

    profiles_by_hour = defaultdict(set)
    events_by_hour = defaultdict(int)

    for (
        event_timezone,
        utc_date,
        utc_hour,
        profile_id,
        event_count,
    ) in result.result_rows:

        timezone_name = (
            str(
                event_timezone
                or 'UTC'
            )
            .strip()
            or 'UTC'
        )

        try:
            tz = ZoneInfo(
                timezone_name
            )
        except ZoneInfoNotFoundError:
            tz = ZoneInfo('UTC')

        utc_dt = _datetime.combine(
            utc_date,
            _time(
                hour=int(
                    utc_hour
                )
            ),
            tzinfo=_timezone.utc,
        )

        local_hour = int(
            utc_dt
            .astimezone(tz)
            .hour
        )

        profiles_by_hour[
            local_hour
        ].add(
            str(profile_id)
        )

        events_by_hour[
            local_hour
        ] += int(
            event_count
        )

    return [
        {
            'hour': hour,
            'active_profiles': len(
                profiles_by_hour.get(
                    hour,
                    set(),
                )
            ),
            'events': int(
                events_by_hour.get(
                    hour,
                    0,
                )
            ),
        }
        for hour in range(24)
    ]


def audience_peak_hours(
    *,
    start_at,
    end_at,
    country_code=None,
    limit=5,
    client=None,
):
    """
    Return the strongest local audience hours.

    Ranking:
    1. active_profiles DESC
    2. events DESC
    3. hour ASC
    """
    try:
        limit = int(limit)
    except (TypeError, ValueError) as exc:
        raise ValueError(
            'limit must be an integer'
        ) from exc

    if limit < 1 or limit > 24:
        raise ValueError(
            'limit must be between 1 and 24'
        )

    rows = audience_hourly_activity(
        start_at=start_at,
        end_at=end_at,
        country_code=country_code,
        client=client,
    )

    ranked = sorted(
        rows,
        key=lambda row: (
            -row['active_profiles'],
            -row['events'],
            row['hour'],
        ),
    )

    return ranked[:limit]





def audience_peak_hours_by_country(
    *,
    start_at,
    end_at,
    limit_per_country=3,
    client=None,
):
    """
    Return peak local audience hours grouped by country.

    ClickHouse aggregates by:
      country / timezone / real UTC date / UTC hour / profile.

    Python performs only timezone bucket conversion and ranking.
    Real UTC date preserves DST behavior.

    country_code never determines timezone.
    """
    from collections import defaultdict
    from datetime import (
        datetime as _datetime,
        time as _time,
        timezone as _timezone,
    )
    from zoneinfo import (
        ZoneInfo,
        ZoneInfoNotFoundError,
    )

    try:
        limit_per_country = int(
            limit_per_country
        )
    except (
        TypeError,
        ValueError,
    ) as exc:
        raise ValueError(
            'limit_per_country must be an integer'
        ) from exc

    if (
        limit_per_country < 1
        or limit_per_country > 24
    ):
        raise ValueError(
            'limit_per_country must be between 1 and 24'
        )

    client = (
        client
        or clickhouse_client()
    )

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    start_at = _analytics_datetime(
        start_at
    )

    end_at = _analytics_datetime(
        end_at
    )

    if end_at <= start_at:
        raise ValueError(
            'end_at must be after start_at'
        )

    result = client.query(
        f"""
        SELECT
            country_code,

            if(
                timezone = '',
                'UTC',
                timezone
            ) AS event_timezone,

            toDate(
                occurred_at
            ) AS utc_date,

            toHour(
                occurred_at
            ) AS utc_hour,

            profile_id,

            count() AS events

        FROM analytics_events

        WHERE
            {AUDIENCE_ACTIVITY_FILTER}

            AND country_code != ''

            AND occurred_at >= {{start_at:DateTime64(3)}}

            AND occurred_at < {{end_at:DateTime64(3)}}

        GROUP BY
            country_code,
            event_timezone,
            utc_date,
            utc_hour,
            profile_id
        """,
        parameters={
            'start_at': start_at,
            'end_at': end_at,
        },
    )

    profiles = defaultdict(
        lambda: defaultdict(set)
    )

    events = defaultdict(
        lambda: defaultdict(int)
    )

    for (
        country_code,
        event_timezone,
        utc_date,
        utc_hour,
        profile_id,
        event_count,
    ) in result.result_rows:

        country = str(
            country_code
            or ''
        ).upper()

        timezone_name = (
            str(
                event_timezone
                or 'UTC'
            )
            .strip()
            or 'UTC'
        )

        try:
            tz = ZoneInfo(
                timezone_name
            )
        except ZoneInfoNotFoundError:
            tz = ZoneInfo('UTC')

        utc_dt = _datetime.combine(
            utc_date,
            _time(
                hour=int(
                    utc_hour
                )
            ),
            tzinfo=_timezone.utc,
        )

        local_hour = int(
            utc_dt
            .astimezone(tz)
            .hour
        )

        profiles[
            country
        ][
            local_hour
        ].add(
            str(profile_id)
        )

        events[
            country
        ][
            local_hour
        ] += int(
            event_count
        )

    output = []

    for country in sorted(
        profiles
    ):
        rows = [
            {
                'hour': hour,
                'active_profiles': len(
                    profiles[
                        country
                    ].get(
                        hour,
                        set(),
                    )
                ),
                'events': int(
                    events[
                        country
                    ].get(
                        hour,
                        0,
                    )
                ),
            }
            for hour in range(24)
        ]

        rows.sort(
            key=lambda row: (
                -row[
                    'active_profiles'
                ],
                -row[
                    'events'
                ],
                row[
                    'hour'
                ],
            )
        )

        output.append(
            {
                'country_code': (
                    country
                ),
                'peak_hours': rows[
                    :limit_per_country
                ],
            }
        )

    return output


CONTENT_ANALYTICS_DIMENSIONS = {
    'content',
    'producer',
    'content_type',
    'genre',
}


def content_dimension_analytics(
    start_at,
    end_at,
    *,
    dimension,
    limit=100,
    client=None,
):
    """
    Aggregate real video analytics by frozen event dimension.

    Business KPI semantics
    ----------------------
    events:
        Number of video lifecycle event rows.

    play_starts:
        Distinct viewing sessions with at least one video_start.

    qualified_views:
        Distinct viewing sessions whose cumulative strict
        watch_seconds reaches the qualification threshold.

        Threshold:
        - known duration < 300 seconds:
          10% of duration;
        - known duration >= 300 seconds:
          30 seconds;
        - unknown duration:
          30 seconds.

    unique_viewers:
        Distinct profiles owning at least one qualified view.

    watch_seconds:
        Sum of strict watch-time DELTAS.

    completed_views:
        Distinct viewing sessions with at least one
        video_complete.

    qualification_rate_percent:
        qualified_views / play_starts * 100.

    completion_percent_avg:
        Average maximum playback completion reached per
        viewing session when duration is known.

    position_seconds is intentionally not used to qualify
    a view because it is an absolute player position and
    can be changed by seeking.

    PostgreSQL is intentionally not joined. Dimensions are
    frozen in analytics_events at event creation time.

    For genre, one viewing session can contribute to each
    genre attached to the content.
    """
    dimension = str(
        dimension or ''
    ).strip().lower()

    if dimension not in CONTENT_ANALYTICS_DIMENSIONS:
        raise ValueError(
            'dimension must be one of: '
            'content, producer, content_type, genre'
        )

    start_at = _analytics_datetime(
        start_at
    )

    end_at = _analytics_datetime(
        end_at
    )

    if start_at >= end_at:
        raise ValueError(
            'start_at must be before end_at'
        )

    try:
        limit = int(limit)
    except (TypeError, ValueError):
        raise ValueError(
            'limit must be an integer'
        )

    if not 1 <= limit <= 1000:
        raise ValueError(
            'limit must be between 1 and 1000'
        )

    if client is None:
        client = clickhouse_client()

    if dimension == 'content':
        dimension_expression = (
            'toString(content_id)'
        )

        dimension_filter = (
            'content_id IS NOT NULL'
        )

        array_join = ''

    elif dimension == 'producer':
        dimension_expression = (
            'toString(producer_id)'
        )

        dimension_filter = (
            'producer_id IS NOT NULL'
        )

        array_join = ''

    elif dimension == 'content_type':
        dimension_expression = (
            'content_type'
        )

        dimension_filter = (
            "content_type IN ('movie', 'series')"
        )

        array_join = ''

    else:
        dimension_expression = 'genre'

        dimension_filter = (
            "genre != ''"
        )

        array_join = (
            'ARRAY JOIN genres AS genre'
        )

    query = f"""
        SELECT
            dimension_value,

            sum(session_events) AS events,

            countIf(
                has_start = 1
            ) AS play_starts,

            countIf(
                is_qualified = 1
            ) AS qualified_views,

            uniqExactIf(
                profile_id,
                is_qualified = 1
                AND profile_id IS NOT NULL
            ) AS unique_viewers,

            sum(
                session_watch_seconds
            ) AS watch_seconds,

            countIf(
                has_complete = 1
            ) AS completed_views,

            if(
                play_starts > 0,
                round(
                    qualified_views
                    * 100.0
                    / play_starts,
                    2
                ),
                0.0
            ) AS qualification_rate_percent,

            avgIf(
                session_completion_percent,
                session_duration_seconds > 0
            ) AS completion_percent_avg

        FROM
        (
            SELECT
                dimension_value,
                viewing_session_id,

                any(profile_id) AS profile_id,

                count() AS session_events,

                sum(watch_seconds)
                    AS session_watch_seconds,

                max(duration_seconds)
                    AS session_duration_seconds,

                max(completion_percent)
                    AS session_completion_percent,

                max(
                    event_name = 'video_start'
                ) AS has_start,

                max(
                    event_name = 'video_complete'
                ) AS has_complete,

                (
                    session_watch_seconds
                    >=
                    if(
                        session_duration_seconds > 0,
                        least(
                            30.0,
                            session_duration_seconds
                            * 0.10
                        ),
                        30.0
                    )
                ) AS is_qualified

            FROM
            (
                SELECT
                    {dimension_expression}
                        AS dimension_value,

                    viewing_session_id,
                    profile_id,
                    event_name,
                    watch_seconds,
                    duration_seconds,
                    completion_percent

                FROM analytics_events

                {array_join}

                WHERE
                    occurred_at
                        >= {{start_at:DateTime64(3)}}

                    AND occurred_at
                        < {{end_at:DateTime64(3)}}

                    AND event_name IN (
                        'video_start',
                        'video_progress',
                        'video_complete',
                        'video_abandon'
                    )

                    AND is_internal = 0
                    AND is_test = 0

                    AND viewing_session_id
                        IS NOT NULL

                    AND {dimension_filter}
            )

            GROUP BY
                dimension_value,
                viewing_session_id
        )

        GROUP BY dimension_value

        ORDER BY
            qualified_views DESC,
            watch_seconds DESC,
            unique_viewers DESC,
            completed_views DESC,
            qualification_rate_percent DESC,
            dimension_value ASC

        LIMIT {{limit:UInt32}}
    """

    result = client.query(
        query,
        parameters={
            'start_at': start_at,
            'end_at': end_at,
            'limit': limit,
        },
    )

    rows = []

    for row in result.result_rows:
        (
            dimension_value,
            events,
            play_starts,
            qualified_views,
            unique_viewers,
            watch_seconds,
            completed_views,
            qualification_rate_percent,
            completion_percent_avg,
        ) = row

        rows.append(
            {
                'dimension':
                    dimension,

                'value':
                    str(dimension_value),

                'events':
                    int(events or 0),

                'play_starts':
                    int(play_starts or 0),

                'qualified_views':
                    int(qualified_views or 0),

                'unique_viewers':
                    int(unique_viewers or 0),

                'watch_seconds':
                    int(watch_seconds or 0),

                'completed_views':
                    int(completed_views or 0),

                'qualification_rate_percent':
                    round(
                        float(
                            qualification_rate_percent
                            or 0.0
                        ),
                        2,
                    ),

                'completion_percent_avg':
                    round(
                        float(
                            completion_percent_avg
                            or 0.0
                        ),
                        2,
                    ),
            }
        )

    return rows


CONTENT_ANALYTICS_RANKING_ORDER = (
    'qualified_views',
    'watch_seconds',
    'unique_viewers',
    'completed_views',
    'qualification_rate_percent',
)


def content_dimension_ranking(
    start_at,
    end_at,
    *,
    dimension,
    limit=10,
    client=None,
):
    """
    Return a deterministic period ranking for one analytics dimension.

    This function intentionally reuses content_dimension_analytics()
    so there is one authoritative implementation of the business KPIs.

    Ranking priority:
    1. qualified_views DESC
    2. watch_seconds DESC
    3. unique_viewers DESC
    4. completed_views DESC
    5. qualification_rate_percent DESC
    6. dimension value ASC as deterministic tie-break.

    Important:
    - rank is an ordinal position: 1, 2, 3...
    - this is analytics ranking only;
    - this is NOT the persisted/editorial Top 10 planned for G5-1D7.
    """
    try:
        limit = int(limit)
    except (TypeError, ValueError):
        raise ValueError(
            'limit must be an integer'
        )

    if not 1 <= limit <= 100:
        raise ValueError(
            'ranking limit must be between 1 and 100'
        )

    rows = content_dimension_analytics(
        start_at,
        end_at,
        dimension=dimension,
        limit=limit,
        client=client,
    )

    ranked = []

    for position, row in enumerate(
        rows,
        start=1,
    ):
        ranked_row = dict(row)

        ranked_row['rank'] = position

        ranked.append(
            ranked_row
        )

    return ranked


# ==========================================================
# G5-1D5B1 — APP SESSION ANALYTICS
# ==========================================================

APP_SESSION_EVENT_NAMES = (
    'app_session_start',
    'app_session_end',
)


def build_app_session_analytics_event(
    event_name,
    *,
    profile,
    session_id,
    occurred_at=None,
    platform='',
    device_type='',
    app_version='',
    timezone_name='UTC',
    duration_seconds=None,
    properties=None,
):
    """
    Build an analytics event for a real EKEFLICKS app session.

    App session identity:
        analytics_events.session_id

    This is intentionally independent from:
        - ViewingSession / viewing_session_id;
        - core.UserSession used by authentication/admin sessions.

    Contract:
        - profile is mandatory;
        - session_id is mandatory UUID;
        - user_id is derived from profile.user_id;
        - profile_type is derived from profile.type;
        - app_session_end may carry duration_seconds;
        - duration is never inferred when absent.
    """

    if event_name not in APP_SESSION_EVENT_NAMES:
        raise ValueError(
            'Unsupported app session event: '
            f'{event_name}'
        )

    if profile is None:
        raise ValueError(
            'profile is required'
        )

    if not getattr(
        profile,
        'id',
        None,
    ):
        raise ValueError(
            'profile.id is required'
        )

    user_id = getattr(
        profile,
        'user_id',
        None,
    )

    if not user_id:
        raise ValueError(
            'profile.user_id is required'
        )

    if session_id is None or str(session_id).strip() == '':
        raise ValueError(
            'session_id is required'
        )

    normalized_session_id = _analytics_uuid(
        session_id,
        nullable=False,
    )

    profile_type = ''

    profile_type_obj = getattr(
        profile,
        'type',
        None,
    )

    if profile_type_obj is not None:
        profile_type = str(
            getattr(
                profile_type_obj,
                'name',
                '',
            )
            or ''
        ).strip().lower()

    if profile_type not in (
        'main',
        'child',
        'guest',
    ):
        raise ValueError(
            'Unsupported profile_type: '
            f'{profile_type}'
        )

    country_code = str(
        getattr(
            getattr(
                profile,
                'user',
                None,
            ),
            'country_code',
            '',
        )
        or getattr(
            profile,
            'country_code',
            '',
        )
        or ''
    ).strip().upper()

    event_properties = dict(
        properties or {}
    )

    if event_name == 'app_session_start':
        if duration_seconds is not None:
            raise ValueError(
                'duration_seconds is not allowed '
                'for app_session_start'
            )

    if event_name == 'app_session_end':
        if duration_seconds is not None:
            try:
                duration_seconds = int(
                    duration_seconds
                )
            except (
                TypeError,
                ValueError,
            ) as exc:
                raise ValueError(
                    'duration_seconds must be '
                    'an integer'
                ) from exc

            if duration_seconds < 0:
                raise ValueError(
                    'duration_seconds must be >= 0'
                )

            event_properties[
                'duration_seconds'
            ] = duration_seconds

    return build_analytics_event(
        event_name,
        occurred_at=occurred_at,
        user_id=str(
            user_id
        ),
        profile_id=str(
            profile.id
        ),
        profile_type=profile_type,
        country_code=country_code,
        timezone=(
            str(
                timezone_name
                or 'UTC'
            ).strip()
            or 'UTC'
        ),
        platform=platform,
        device_type=device_type,
        app_version=app_version,
        session_id=normalized_session_id,
        viewing_session_id=None,
        properties=event_properties,
    )


# ---------------------------------------------------------------------------
# G5-1D5B3 — Application session analytics
# ---------------------------------------------------------------------------

APP_SESSION_ANALYTICS_EVENT_NAMES = (
    "app_session_start",
    "app_session_end",
)


def app_session_analytics(*, start_at=None, end_at=None):
    """
    Aggregate real application sessions from ClickHouse.

    Contract:
    - session identity is analytics_events.session_id;
    - viewing_session_id is unrelated and is never used here;
    - only app_session_start/app_session_end events participate;
    - internal/test events and events without profile/session are excluded;
    - duplicate START/END events do not create duplicate sessions;
    - first START and last END define a closed session;
    - duration is derived exclusively from occurred_at;
    - open sessions count toward sessions but not average duration.
    """

    where = [
        "event_name IN ('app_session_start', 'app_session_end')",
        "is_internal = 0",
        "is_test = 0",
        "profile_id IS NOT NULL",
        "session_id IS NOT NULL",
    ]

    parameters = {}

    if start_at is not None:
        where.append("occurred_at >= {start_at:DateTime64(3, 'UTC')}")
        parameters["start_at"] = start_at

    if end_at is not None:
        where.append("occurred_at < {end_at:DateTime64(3, 'UTC')}")
        parameters["end_at"] = end_at

    where_sql = "\n          AND ".join(where)

    query = f"""
        WITH sessionized AS
        (
            SELECT
                session_id,

                argMin(profile_id, occurred_at) AS profile_id,

                minIf(
                    occurred_at,
                    event_name = 'app_session_start'
                ) AS started_at,

                maxIf(
                    occurred_at,
                    event_name = 'app_session_end'
                ) AS ended_at,

                countIf(
                    event_name = 'app_session_start'
                ) AS start_count,

                countIf(
                    event_name = 'app_session_end'
                ) AS end_count

            FROM analytics_events

            WHERE {where_sql}

            GROUP BY session_id
        ),

        valid_sessions AS
        (
            SELECT
                session_id,
                profile_id,
                started_at,
                ended_at,

                start_count > 0 AS has_start,
                end_count > 0 AS has_end,

                (
                    start_count > 0
                    AND end_count > 0
                    AND ended_at >= started_at
                ) AS is_closed,

                if(
                    start_count > 0
                    AND end_count > 0
                    AND ended_at >= started_at,

                    greatest(
                        0.0,
                        dateDiff(
                            'millisecond',
                            started_at,
                            ended_at
                        ) / 1000.0
                    ),

                    NULL
                ) AS duration_seconds

            FROM sessionized

            WHERE start_count > 0
        )

        SELECT
            count() AS sessions,

            uniqExact(profile_id) AS unique_profiles,

            countIf(is_closed) AS closed_sessions,

            countIf(NOT is_closed) AS open_sessions,

            if(
                countIf(is_closed) = 0,
                0.0,
                avgIf(
                    duration_seconds,
                    is_closed
                )
            ) AS avg_session_duration_seconds,

            if(
                uniqExact(profile_id) = 0,
                0.0,
                count() / uniqExact(profile_id)
            ) AS sessions_per_profile

        FROM valid_sessions
    """

    result = clickhouse_client().query(
        query,
        parameters=parameters,
    )

    if not result.result_rows:
        return {
            "sessions": 0,
            "unique_profiles": 0,
            "closed_sessions": 0,
            "open_sessions": 0,
            "avg_session_duration_seconds": 0.0,
            "sessions_per_profile": 0.0,
        }

    row = result.result_rows[0]

    return {
        "sessions": int(row[0] or 0),
        "unique_profiles": int(row[1] or 0),
        "closed_sessions": int(row[2] or 0),
        "open_sessions": int(row[3] or 0),
        "avg_session_duration_seconds": float(row[4] or 0.0),
        "sessions_per_profile": float(row[5] or 0.0),
    }
