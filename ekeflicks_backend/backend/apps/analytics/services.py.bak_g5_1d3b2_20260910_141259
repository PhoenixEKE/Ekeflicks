import json
import uuid
from datetime import datetime, timezone as dt_timezone

from django.core.cache import cache


ANALYTICS_EVENT_COLUMNS = [
    'event_id',
    'event_name',
    'event_version',
    'occurred_at',
    'user_id',
    'profile_id',
    'profile_type',
    'content_id',
    'episode_id',
    'producer_id',
    'content_type',
    'genres',
    'country_code',
    'timezone',
    'interface_language',
    'query_language',
    'audio_language',
    'subtitle_language',
    'platform',
    'device_type',
    'app_version',
    'session_id',
    'viewing_session_id',
    'watch_seconds',
    'position_seconds',
    'duration_seconds',
    'completion_percent',
    'search_query',
    'recommendation_source',
    'recommendation_context',
    'properties',
    'is_internal',
    'is_test',
]


_UUID_FIELDS = (
    'user_id',
    'profile_id',
    'content_id',
    'episode_id',
    'producer_id',
    'session_id',
    'viewing_session_id',
)


def _analytics_uuid(value, *, nullable=True):
    if value in (None, ''):
        if nullable:
            return None
        return uuid.uuid4()

    if isinstance(value, uuid.UUID):
        return value

    return uuid.UUID(str(value))


def _analytics_datetime(value):
    if value in (None, ''):
        return datetime.now(dt_timezone.utc)

    if isinstance(value, datetime):
        parsed = value
    else:
        parsed = datetime.fromisoformat(
            str(value).replace('Z', '+00:00')
        )

    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt_timezone.utc)

    return parsed.astimezone(dt_timezone.utc)


def normalize_analytics_event(payload):
    payload = dict(payload or {})

    event_name = str(payload.get('event_name') or '').strip()
    if not event_name:
        raise ValueError('event_name is required')

    event_id = _analytics_uuid(
        payload.get('event_id'),
        nullable=False,
    )

    content_type = str(
        payload.get('content_type') or ''
    ).strip().lower()

    if content_type not in ('', 'movie', 'series'):
        raise ValueError(
            'content_type must be movie, series, or empty'
        )

    properties = payload.get('properties', {})

    if isinstance(properties, str):
        try:
            decoded = json.loads(properties)
        except json.JSONDecodeError as exc:
            raise ValueError(
                'properties must contain valid JSON'
            ) from exc
        properties = decoded

    if not isinstance(properties, dict):
        raise ValueError(
            'properties must be a JSON object'
        )

    normalized = {
        'event_id': event_id,
        'event_name': event_name,
        'event_version': int(
            payload.get('event_version') or 1
        ),
        'occurred_at': _analytics_datetime(
            payload.get('occurred_at')
        ),

        'user_id': None,
        'profile_id': None,
        'profile_type': str(
            payload.get('profile_type') or ''
        ),

        'content_id': None,
        'episode_id': None,
        'producer_id': None,

        'content_type': content_type,
        'genres': [
            str(value)
            for value in (payload.get('genres') or [])
        ],

        'country_code': str(
            payload.get('country_code') or ''
        ).upper(),
        'timezone': str(
            payload.get('timezone') or 'UTC'
        ),

        'interface_language': str(
            payload.get('interface_language') or ''
        ).lower(),
        'query_language': str(
            payload.get('query_language') or ''
        ).lower(),
        'audio_language': str(
            payload.get('audio_language') or ''
        ).lower(),
        'subtitle_language': str(
            payload.get('subtitle_language') or ''
        ).lower(),

        'platform': str(
            payload.get('platform') or ''
        ).lower(),
        'device_type': str(
            payload.get('device_type') or ''
        ).lower(),
        'app_version': str(
            payload.get('app_version') or ''
        ),

        'session_id': None,
        'viewing_session_id': None,

        'watch_seconds': max(
            0,
            int(payload.get('watch_seconds') or 0),
        ),
        'position_seconds': max(
            0,
            int(payload.get('position_seconds') or 0),
        ),
        'duration_seconds': max(
            0,
            int(payload.get('duration_seconds') or 0),
        ),
        'completion_percent': max(
            0.0,
            min(
                100.0,
                float(
                    payload.get(
                        'completion_percent',
                        0,
                    ) or 0
                ),
            ),
        ),

        'search_query': str(
            payload.get('search_query') or ''
        ),
        'recommendation_source': str(
            payload.get('recommendation_source') or ''
        ),
        'recommendation_context': str(
            payload.get('recommendation_context') or ''
        ),

        'properties': json.dumps(
            properties,
            ensure_ascii=False,
            separators=(',', ':'),
            sort_keys=True,
        ),

        'is_internal': int(
            bool(payload.get('is_internal', False))
        ),
        'is_test': int(
            bool(payload.get('is_test', False))
        ),
    }

    for field in _UUID_FIELDS:
        normalized[field] = _analytics_uuid(
            payload.get(field)
        )

    return normalized


def analytics_event_exists(event_id, client=None):
    event_id = _analytics_uuid(
        event_id,
        nullable=False,
    )

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    result = client.query(
        '''
        SELECT count()
        FROM analytics_events
        WHERE event_id = {event_id:UUID}
        ''',
        parameters={
            'event_id': str(event_id),
        },
    )

    return int(result.result_rows[0][0]) > 0


def write_analytics_event(payload):
    normalized = normalize_analytics_event(payload)

    event_id = normalized['event_id']
    lock_key = f'analytics:event:{event_id}'

    acquired = cache.add(
        lock_key,
        '1',
        timeout=60,
    )

    if not acquired:
        return {
            'event_id': str(event_id),
            'status': 'locked',
            'inserted': False,
        }

    try:
        client = clickhouse_client()

        if client is None:
            raise RuntimeError(
                'ClickHouse is unavailable'
            )

        if analytics_event_exists(
            event_id,
            client=client,
        ):
            return {
                'event_id': str(event_id),
                'status': 'duplicate',
                'inserted': False,
            }

        row = [
            normalized[column]
            for column in ANALYTICS_EVENT_COLUMNS
        ]

        client.insert(
            'analytics_events',
            [row],
            column_names=ANALYTICS_EVENT_COLUMNS,
        )

        return {
            'event_id': str(event_id),
            'status': 'inserted',
            'inserted': True,
        }

    finally:
        cache.delete(lock_key)


def build_analytics_event(event_name, **payload):
    event = dict(payload)

    event['event_id'] = str(
        _analytics_uuid(
            event.get('event_id'),
            nullable=False,
        )
    )

    event['event_name'] = event_name

    event.setdefault(
        'occurred_at',
        datetime.now(
            dt_timezone.utc
        ).isoformat(),
    )

    return event


def enqueue_analytics_event(event_name, **payload):
    from apps.analytics.tasks import write_analytics_event_task

    event = build_analytics_event(
        event_name,
        **payload,
    )

    write_analytics_event_task.delay(event)

    return event['event_id']


# ---------------------------------------------------------------------------
# G5-1D2 — Video analytics context
# ---------------------------------------------------------------------------

def build_video_analytics_event(
    event_name,
    viewing_session,
    *,
    position_seconds=None,
    watch_seconds=None,
    completion_percent=None,
    platform='',
    timezone_name='UTC',
    interface_language='',
    app_version='',
    properties=None,
    event_id=None,
    occurred_at=None,
):
    """
    Build an analytics event from a ViewingSession.

    Important identifier semantics:
    - analytics_events.session_id:
      application lifecycle session (G5-1D5), intentionally unset here.
    - analytics_events.viewing_session_id:
      ViewingSession.session_id UUID.
    - ViewingSession database PK is intentionally never exported.

    This helper builds the payload only. It does not enqueue or write it.
    """
    allowed_names = {
        'video_start',
        'video_progress',
        'video_complete',
        'video_abandon',
    }

    if event_name not in allowed_names:
        raise ValueError(
            'Unsupported video analytics event: '
            f'{event_name}'
        )

    session = viewing_session

    content = session.content
    profile = session.profile
    user = profile.user
    episode = session.episode

    profile_type = ''
    if getattr(profile, 'type_id', None):
        profile_type_obj = getattr(profile, 'type', None)
        if profile_type_obj is not None:
            profile_type = (
                getattr(profile_type_obj, 'name', '')
                or ''
            )

    genres = list(
        content.genres
        .order_by('name')
        .values_list('name', flat=True)
    )

    producer_id = (
        str(content.producer_id)
        if content.producer_id
        else None
    )

    duration_seconds = 0

    # Prefer the technical duration of the published/default video asset.
    asset_queryset = content.video_assets.all()

    if episode is not None:
        asset_queryset = asset_queryset.filter(
            episode=episode
        )
    else:
        asset_queryset = asset_queryset.filter(
            episode__isnull=True
        )

    asset = (
        asset_queryset
        .filter(is_default=True)
        .order_by('-published_at', '-created_at')
        .first()
    )

    if asset is None:
        asset = (
            asset_queryset
            .order_by('-published_at', '-created_at')
            .first()
        )

    if asset is not None and asset.duration_seconds:
        duration_seconds = max(
            0,
            int(asset.duration_seconds),
        )
    elif content.duration:
        # Content.duration is stored in minutes.
        duration_seconds = max(
            0,
            int(content.duration) * 60,
        )

    # Strict analytics semantics:
    #
    # watch_seconds:
    #   active watch-time DELTA represented by this event.
    #
    # position_seconds:
    #   absolute player position represented by this event.
    #
    # Neither value is inferred from ViewingSession.duration_watched
    # and neither value is inferred from the other metric.
    resolved_watch_seconds = max(
        0,
        int(
            0
            if watch_seconds is None
            else watch_seconds
        ),
    )

    resolved_position_seconds = max(
        0,
        int(
            0
            if position_seconds is None
            else position_seconds
        ),
    )

    if completion_percent is None:
        if duration_seconds > 0:
            resolved_completion = min(
                100.0,
                (
                    resolved_position_seconds
                    * 100.0
                    / duration_seconds
                ),
            )
        else:
            resolved_completion = (
                100.0
                if session.was_completed
                else 0.0
            )
    else:
        resolved_completion = max(
            0.0,
            min(
                100.0,
                float(completion_percent),
            ),
        )

    event_properties = dict(properties or {})

    if session.quality_played:
        event_properties.setdefault(
            'quality_played',
            session.quality_played,
        )

    if asset is not None:
        event_properties.setdefault(
            'asset_id',
            str(asset.id),
        )

    event_properties.setdefault(
        'was_completed',
        bool(session.was_completed),
    )

    return build_analytics_event(
        event_name,
        event_id=event_id,
        occurred_at=occurred_at,
        user_id=str(user.id),
        profile_id=str(profile.id),
        profile_type=profile_type,
        content_id=str(content.id),
        episode_id=(
            str(episode.id)
            if episode is not None
            else None
        ),
        producer_id=producer_id,
        content_type=content.type,
        genres=genres,
        country_code=(
            getattr(user, 'country_code', '')
            or ''
        ),
        timezone=timezone_name or 'UTC',
        interface_language=interface_language or '',
        platform=platform or '',
        device_type=session.device_type or '',
        app_version=app_version or '',
        # Reserved for G5-1D5 application sessions.
        session_id=None,
        # UUID business identifier of ViewingSession.
        viewing_session_id=str(session.session_id),
        watch_seconds=resolved_watch_seconds,
        position_seconds=resolved_position_seconds,
        duration_seconds=duration_seconds,
        completion_percent=resolved_completion,
        properties=event_properties,
    )


