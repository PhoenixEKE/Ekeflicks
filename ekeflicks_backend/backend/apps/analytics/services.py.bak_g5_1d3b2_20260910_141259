AUDIENCE_ACTIVITY_FILTER = """
    profile_id IS NOT NULL
    AND is_internal = 0
    AND is_test = 0
"""


def audience_active_profiles(
    *,
    start_at,
    end_at,
    client=None,
):
    """
    Count distinct active profiles in [start_at, end_at).

    An active profile is a profile with at least one real analytics
    event during the requested period.

    Internal and test events are excluded.
    """
    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    result = client.query(
        f"""
        SELECT uniqExact(profile_id)
        FROM analytics_events
        WHERE
            {AUDIENCE_ACTIVITY_FILTER}
            AND occurred_at >= {{start_at:DateTime64(3)}}
            AND occurred_at < {{end_at:DateTime64(3)}}
        """,
        parameters={
            'start_at': _analytics_datetime(start_at),
            'end_at': _analytics_datetime(end_at),
        },
    )

    return int(result.result_rows[0][0])


def audience_snapshot(
    *,
    as_of,
    client=None,
):
    """
    Return rolling audience metrics ending at `as_of`.

    DAU = unique active profiles during the previous 24 hours.
    WAU = unique active profiles during the previous 7 days.
    MAU = unique active profiles during the previous 30 days.

    Stickiness = DAU / MAU * 100.
    """
    from datetime import timedelta

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    end_at = _analytics_datetime(as_of)

    dau = audience_active_profiles(
        start_at=end_at - timedelta(days=1),
        end_at=end_at,
        client=client,
    )

    wau = audience_active_profiles(
        start_at=end_at - timedelta(days=7),
        end_at=end_at,
        client=client,
    )

    mau = audience_active_profiles(
        start_at=end_at - timedelta(days=30),
        end_at=end_at,
        client=client,
    )

    stickiness = (
        round(
            dau * 100.0 / mau,
            2,
        )
        if mau
        else 0.0
    )

    return {
        'as_of': end_at.isoformat(),
        'dau': dau,
        'wau': wau,
        'mau': mau,
        'stickiness_percent': stickiness,
    }


def audience_by_dimension(
    *,
    start_at,
    end_at,
    dimension,
    client=None,
):
    """
    Count distinct active profiles by an approved analytics dimension.
    """
    allowed_dimensions = {
        'country_code',
        'profile_type',
        'platform',
        'device_type',
        'interface_language',
    }

    if dimension not in allowed_dimensions:
        raise ValueError(
            f'Unsupported audience dimension: {dimension}'
        )

    client = client or clickhouse_client()

    if client is None:
        raise RuntimeError(
            'ClickHouse is unavailable'
        )

    result = client.query(
        f"""
        SELECT
            {dimension},
            uniqExact(profile_id) AS active_profiles
        FROM analytics_events
        WHERE
            {AUDIENCE_ACTIVITY_FILTER}
            AND occurred_at >= {{start_at:DateTime64(3)}}
            AND occurred_at < {{end_at:DateTime64(3)}}
        GROUP BY {dimension}
        ORDER BY
            active_profiles DESC,
            {dimension} ASC
        """,
        parameters={
            'start_at': _analytics_datetime(start_at),
            'end_at': _analytics_datetime(end_at),
        },
    )

    return [
        {
            dimension: (
                value
                if value is not None
                else ''
            ),
            'active_profiles': int(active_profiles),
        }
        for value, active_profiles
        in result.result_rows
    ]
