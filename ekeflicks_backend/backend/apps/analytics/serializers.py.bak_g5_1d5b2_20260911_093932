class AudienceSnapshotQuerySerializer(
    serializers.Serializer
):
    as_of = serializers.DateTimeField(
        required=False,
    )


class AudienceDimensionQuerySerializer(
    serializers.Serializer
):
    DIMENSION_CHOICES = (
        'country_code',
        'profile_type',
        'platform',
        'device_type',
        'interface_language',
    )

    start_at = serializers.DateTimeField()
    end_at = serializers.DateTimeField()

    dimension = serializers.ChoiceField(
        choices=DIMENSION_CHOICES,
    )

    def validate(self, attrs):
        if (
            attrs['end_at']
            <= attrs['start_at']
        ):
            raise serializers.ValidationError(
                {
                    'end_at': (
                        'end_at must be after '
                        'start_at.'
                    )
                }
            )

        return attrs


