import 'dart:convert';

import 'package:http/browser_client.dart';
import 'package:http/http.dart' as http;

class ApiException implements Exception {
  final String message;
  final int? statusCode;

  const ApiException(this.message, {this.statusCode});

  @override
  String toString() => message;
}

class ApiClient {
  ApiClient._();

  static final ApiClient instance = ApiClient._();

  static const String baseUrl = 'https://api.ekeflicks.com';

  final BrowserClient _client = BrowserClient()..withCredentials = true;

  String? _accessToken;
  String _languageCode = 'fr';

  Future<bool>? _refreshInFlight;

  String? get accessToken => _accessToken;
  String get languageCode => _languageCode;

  bool get hasAccessToken => _accessToken != null && _accessToken!.isNotEmpty;

  void setAccessToken(String? token) {
    _accessToken = token;
  }

  void setLanguageCode(String code) {
    _languageCode = code == 'en' ? 'en' : 'fr';
  }

  Future<bool> _refreshAccessToken({required String? tokenUsed}) async {
    // Une autre requête a peut-être déjà renouvelé le jeton.
    if (_accessToken != tokenUsed && hasAccessToken) {
      return true;
    }

    final pending = _refreshInFlight;
    if (pending != null) {
      return pending;
    }

    final future = _performTokenRefresh();
    _refreshInFlight = future;

    try {
      return await future;
    } finally {
      if (identical(_refreshInFlight, future)) {
        _refreshInFlight = null;
      }
    }
  }

  Future<bool> _performTokenRefresh() async {
    try {
      final response = await _client.post(
        Uri.parse('$baseUrl/api/v1/auth/web/refresh/'),
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'Accept-Language': _languageCode,
        },
        body: '{}',
      );

      if (response.statusCode != 200) {
        _accessToken = null;
        return false;
      }

      final data = jsonDecode(response.body);
      if (data is! Map<String, dynamic>) {
        _accessToken = null;
        return false;
      }

      final access = data['access']?.toString();
      if (access == null || access.isEmpty) {
        _accessToken = null;
        return false;
      }

      _accessToken = access;
      return true;
    } catch (_) {
      _accessToken = null;
      return false;
    }
  }

  Future<http.Response> _sendWithRefresh(
    Future<http.Response> Function() send, {
    required String path,
    required bool authenticated,
  }) async {
    final tokenUsed = _accessToken;
    final response = await send();

    if (!authenticated ||
        response.statusCode != 401 ||
        path.startsWith('/api/v1/auth/web/')) {
      return response;
    }

    final refreshed = await _refreshAccessToken(tokenUsed: tokenUsed);
    if (!refreshed) {
      return response;
    }

    // Une seule nouvelle tentative. Les appels multipart restent exclus.
    return send();
  }

  Map<String, String> _headers({bool authenticated = false}) {
    final headers = <String, String>{
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'Accept-Language': _languageCode,
    };

    if (authenticated && hasAccessToken) {
      headers['Authorization'] = 'Bearer $_accessToken';
    }

    return headers;
  }

  Future<http.Response> get(String path, {bool authenticated = false}) {
    return _sendWithRefresh(
      () => _client.get(
        Uri.parse('$baseUrl$path'),
        headers: _headers(authenticated: authenticated),
      ),
      path: path,
      authenticated: authenticated,
    );
  }

  Future<http.Response> getBytes(String path, {bool authenticated = false}) {
    return _sendWithRefresh(
      () => _client.get(
        Uri.parse('$baseUrl$path'),
        headers: _headers(authenticated: authenticated),
      ),
      path: path,
      authenticated: authenticated,
    );
  }

  Future<http.Response> post(
    String path, {
    Map<String, dynamic>? body,
    bool authenticated = false,
  }) {
    return _sendWithRefresh(
      () => _client.post(
        Uri.parse('$baseUrl$path'),
        headers: _headers(authenticated: authenticated),
        body: jsonEncode(body ?? <String, dynamic>{}),
      ),
      path: path,
      authenticated: authenticated,
    );
  }

  Future<http.Response> postMultipartStream(
    String path, {
    required Stream<List<int>> stream,
    required int length,
    required String filename,
    String fieldName = 'file',
    bool authenticated = false,
    Map<String, String>? fields,
  }) async {
    final request = http.MultipartRequest('POST', Uri.parse('$baseUrl$path'));

    request.headers['Accept'] = 'application/json';

    if (authenticated && hasAccessToken) {
      request.headers['Authorization'] = 'Bearer $_accessToken';
    }

    if (fields != null) {
      request.fields.addAll(fields);
    }

    request.files.add(
      http.MultipartFile(fieldName, stream, length, filename: filename),
    );

    final streamedResponse = await _client.send(request);
    return http.Response.fromStream(streamedResponse);
  }

  Future<http.Response> postMultipart(
    String path, {
    required List<int> bytes,
    required String filename,
    String fieldName = 'file',
    bool authenticated = false,
    Map<String, String>? fields,
  }) async {
    final request = http.MultipartRequest('POST', Uri.parse('$baseUrl$path'));

    request.headers['Accept'] = 'application/json';

    if (authenticated && hasAccessToken) {
      request.headers['Authorization'] = 'Bearer $_accessToken';
    }

    if (fields != null) {
      request.fields.addAll(fields);
    }

    request.files.add(
      http.MultipartFile.fromBytes(fieldName, bytes, filename: filename),
    );

    final streamedResponse = await _client.send(request);
    return http.Response.fromStream(streamedResponse);
  }

  Future<http.Response> patch(
    String path, {
    Map<String, dynamic>? body,
    bool authenticated = false,
  }) {
    return _sendWithRefresh(
      () => _client.patch(
        Uri.parse('$baseUrl$path'),
        headers: _headers(authenticated: authenticated),
        body: jsonEncode(body ?? <String, dynamic>{}),
      ),
      path: path,
      authenticated: authenticated,
    );
  }

  Future<http.Response> delete(String path, {bool authenticated = false}) {
    return _sendWithRefresh(
      () => _client.delete(
        Uri.parse('$baseUrl$path'),
        headers: _headers(authenticated: authenticated),
      ),
      path: path,
      authenticated: authenticated,
    );
  }

  dynamic decode(http.Response response) {
    if (response.body.isEmpty) {
      return null;
    }

    try {
      return jsonDecode(response.body);
    } catch (_) {
      return null;
    }
  }

  String errorMessage(
    http.Response response, {
    String fallback = 'Une erreur est survenue.',
  }) {
    final data = decode(response);
    final message = _extractErrorMessage(data);

    if (message != null && message.trim().isNotEmpty) {
      return message.trim();
    }

    return fallback;
  }

  String? _extractErrorMessage(dynamic value) {
    if (value == null) {
      return null;
    }

    if (value is String) {
      final text = value.trim();
      return text.isEmpty ? null : text;
    }

    if (value is List) {
      for (final item in value) {
        final message = _extractErrorMessage(item);
        if (message != null && message.isNotEmpty) {
          return message;
        }
      }
      return null;
    }

    if (value is Map) {
      const priorityKeys = <String>[
        'detail',
        'non_field_errors',
        'email',
        'phone',
        'password',
        'company_name',
        'legal_name',
        'legal_form',
        'registration_number',
        'country_code',
        'address',
        'city',
        'representative_name',
        'representative_role',
      ];

      for (final key in priorityKeys) {
        if (value.containsKey(key)) {
          final message = _extractErrorMessage(value[key]);
          if (message != null && message.isNotEmpty) {
            return message;
          }
        }
      }

      for (final entry in value.entries) {
        final message = _extractErrorMessage(entry.value);
        if (message != null && message.isNotEmpty) {
          return message;
        }
      }
    }

    return null;
  }
}
