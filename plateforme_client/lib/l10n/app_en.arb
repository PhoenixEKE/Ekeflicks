  "faqQuestion1": "How do I create an account on EkeFlicks?",
  "@faqQuestion1": {
    "description": "FAQ question about account creation"
  },
  "faqAnswer1": "To create an account, click the 'Sign Up' button in the top right corner of the homepage. Fill out the form with your email, a secure password, and your personal information. You will receive a confirmation email to activate your account.",
  "@faqAnswer1": {
    "description": "Answer to account creation question"
  },

  "faqQuestion2": "Can I modify my profile information?",
  "@faqQuestion2": {
    "description": "FAQ question about profile modification"
  },
  "faqAnswer2": "Yes, you can modify your profile at any time. Go to 'My Account' from the navigation menu. You can change your profile picture, name, email, and notification preferences.",
  "@faqAnswer2": {
    "description": "Answer to profile modification question"
  },

  "faqQuestion3": "How do I create family profiles?",
  "@faqQuestion3": {
    "description": "FAQ question about family profiles"
  },
  "faqAnswer3": "EkeFlicks allows up to 5 profiles per account. In 'Profile Management', click 'Add Profile'. You can create child profiles with appropriate content restrictions, or adult profiles for other family members.",
  "@faqAnswer3": {
    "description": "Answer to family profiles question"
  },

  "faqQuestion4": "What payment methods are accepted?",
  "@faqQuestion4": {
    "description": "FAQ question about payment methods"
  },
  "faqAnswer4": "We accept credit cards (Visa, MasterCard, American Express), debit cards, PayPal, and e-wallets depending on your region. All payments are secure and encrypted.",
  "@faqAnswer4": {
    "description": "Answer to payment methods question"
  },

  "faqQuestion5": "How do I cancel my subscription?",
  "@faqQuestion5": {
    "description": "FAQ question about cancellation"
  },
  "faqAnswer5": "You can cancel at any time without fees. Go to 'My Subscription' in your account settings, click 'Manage Subscription' and follow the instructions. Your access will remain active until the end of the paid period.",
  "@faqAnswer5": {
    "description": "Answer to cancellation question"
  },

  "faqQuestion6": "Do you offer refunds?",
  "@faqQuestion6": {
    "description": "FAQ question about refunds"
  },
  "faqAnswer6": "We offer a 14-day satisfaction guarantee for new subscriptions. For existing subscriptions, refunds are evaluated case by case. Contact our customer service for any requests.",
  "@faqAnswer6": {
    "description": "Answer to refunds question"
  },

  "faqQuestion7": "What's the difference between the plans?",
  "@faqQuestion7": {
    "description": "FAQ question about different plans"
  },
  "faqAnswer7": "EkeFlicks offers 3 plans: Basic (1 screen, SD), Standard (2 screens, HD), and Premium (4 screens, 4K UHD). All include full access to our catalog and offline downloads.",
  "@faqAnswer7": {
    "description": "Answer to plans question"
  },

  "faqQuestion8": "Can I download content to watch offline?",
  "@faqQuestion8": {
    "description": "FAQ question about downloads"
  },
  "faqAnswer8": "Yes! Most movies and series can be downloaded for offline viewing. Look for the download icon next to content. Downloads are available for 30 days once started, and 48 hours after playback begins.",
  "@faqAnswer8": {
    "description": "Answer to downloads question"
  },

  "faqQuestion9": "Is content available in all languages?",
  "@faqQuestion9": {
    "description": "FAQ question about available languages"
  },
  "faqAnswer9": "Our catalog offers dubbing and subtitles in French, English, Spanish, and several African languages depending on content. Availability varies by licenses. You can change the language in playback settings.",
  "@faqAnswer9": {
    "description": "Answer to languages question"
  },

  "faqQuestion10": "On how many devices can I use my account?",
  "@faqQuestion10": {
    "description": "FAQ question about compatible devices"
  },
  "faqAnswer10": "You can use EkeFlicks on as many devices as you want, but the number of simultaneous screens depends on your plan: 1 for Basic, 2 for Standard, 4 for Premium. Compatible with smartphones, tablets, TVs, computers.",
  "@faqAnswer10": {
    "description": "Answer to devices question"
  },

  "faqQuestion11": "What to do if I have playback issues?",
  "@faqQuestion11": {
    "description": "FAQ question about technical issues"
  },
  "faqAnswer11": "If you encounter problems: 1) Check your internet connection 2) Restart the app 3) Update the app 4) Clear cache. If the problem persists, contact our technical support with error details.",
  "@faqAnswer11": {
    "description": "Answer to technical issues question"
  },

  "faqQuestion12": "How to contact customer support?",
  "@faqQuestion12": {
    "description": "FAQ question about customer support"
  },
  "faqAnswer12": "Our support team is available 24/7 via live chat, email at support@ekeflicks.com, or phone at +33 1 23 45 67 89. Average response time: less than 2 hours for chat, 24 hours for emails.",
  "@faqAnswer12": {
    "description": "Answer to customer support question"
  },

