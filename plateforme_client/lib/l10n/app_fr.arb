  "privacyPolicyTitle": "Politique de Confidentialité de EKEflicks",
  "@privacyPolicyTitle": {
    "description": "Titre de la page Politique de Confidentialité"
  },

  "privacyPolicyIntro": "Bienvenue sur la Politique de Confidentialité de EKEflicks. Nous accordons une grande importance à la protection de vos informations personnelles. Cette politique explique comment nous collectons, utilisons, partageons et protégeons vos données. En utilisant notre plateforme, vous acceptez les pratiques décrites dans cette politique.",
  "@privacyPolicyIntro": {
    "description": "Introduction de la Politique de Confidentialité"
  },

  "section1Title": "1. Informations Collectées",
  "@section1Title": {
    "description": "Titre de la section 1"
  },

  "section1_1Title": "1.1. Informations Fournies par l'Utilisateur",
  "@section1_1Title": {
    "description": "Titre de la sous-section 1.1"
  },

  "section1_1Text": "Lors de la création d'un compte, de la souscription à des services ou de la communication avec notre équipe de support, vous pouvez nous fournir des informations telles que votre nom, votre adresse e-mail, votre adresse de facturation, etc.",
  "@section1_1Text": {
    "description": "Texte de la sous-section 1.1"
  },

  "section1_2Title": "1.2. Informations Automatiquement Collectées",
  "@section1_2Title": {
    "description": "Titre de la sous-section 1.2"
  },

  "section1_2Text": "Nous pouvons collecter des informations automatiquement à travers l'utilisation de cookies et de technologies similaires, telles que des données de connexion, des informations sur le dispositif utilisé, l'adresse IP, etc.",
  "@section1_2Text": {
    "description": "Texte de la sous-section 1.2"
  },

  "section2Title": "2. Utilisation des Informations",
  "@section2Title": {
    "description": "Titre de la section 2"
  },

  "section2_1Title": "2.1. Fourniture des Services",
  "@section2_1Title": {
    "description": "Titre de la sous-section 2.1"
  },

  "section2_1Text": "Nous utilisons vos informations pour vous fournir les services demandés, y compris la diffusion de contenus vidéo, la gestion des comptes utilisateurs et le traitement des paiements.",
  "@section2_1Text": {
    "description": "Texte de la sous-section 2.1"
  },

  "section2_2Title": "2.2. Amélioration des Services",
  "@section2_2Title": {
    "description": "Titre de la sous-section 2.2"
  },

  "section2_2Text": "Nous utilisons les données collectées pour améliorer la qualité de nos services, personnaliser votre expérience utilisateur et développer de nouvelles fonctionnalités.",
  "@section2_2Text": {
    "description": "Texte de la sous-section 2.2"
  },

  "section2_3Title": "2.3. Communication avec l'Utilisateur",
  "@section2_3Title": {
    "description": "Titre de la sous-section 2.3"
  },

  "section2_3Text": "Nous pouvons utiliser vos informations pour vous envoyer des communications liées au service, des mises à jour, des offres spéciales et des informations sur de nouveaux contenus.",
  "@section2_3Text": {
    "description": "Texte de la sous-section 2.3"
  },

  "section3Title": "3. Partage des Informations",
  "@section3Title": {
    "description": "Titre de la section 3"
  },

  "section3_1Title": "3.1. Partage avec des Partenaires",
  "@section3_1Title": {
    "description": "Titre de la sous-section 3.1"
  },

  "section3_1Text": "Nous pouvons partager certaines informations avec des partenaires de confiance pour la fourniture de services complémentaires, tels que le traitement des paiements.",
  "@section3_1Text": {
    "description": "Texte de la sous-section 3.1"
  },

  "section3_2Title": "3.2. Conformité Légale",
  "@section3_2Title": {
    "description": "Titre de la sous-section 3.2"
  },

  "section3_2Text": "Nous pouvons divulguer des informations dans le respect des lois en vigueur, des procédures judiciaires, et pour protéger nos droits légaux.",
  "@section3_2Text": {
    "description": "Texte de la sous-section 3.2"
  },

  "section4Title": "4. Sécurité des Données",
  "@section4Title": {
    "description": "Titre de la section 4"
  },

  "section4Text": "Nous mettons en place des mesures de sécurité appropriées pour protéger vos informations contre l'accès non autorisé, la divulgation, l'altération et la destruction.",
  "@section4Text": {
    "description": "Texte de la section 4"
  },

  "section5Title": "5. Droits de l'Utilisateur",
  "@section5Title": {
    "description": "Titre de la section 5"
  },

  "section5Text": "Vous avez le droit d'accéder à vos informations, de les rectifier, de les supprimer, ou de restreindre leur traitement. Pour exercer ces droits, veuillez nous contacter à support@ekeflicks.com.",
  "@section5Text": {
    "description": "Texte de la section 5"
  },

  "section6Title": "6. Modifications de la Politique de Confidentialité",
  "@section6Title": {
    "description": "Titre de la section 6"
  },

  "section6Text": "Nous nous réservons le droit de mettre à jour cette Politique de Confidentialité. Toute modification sera publiée sur EKEflicks. En continuant à utiliser nos services après ces modifications, vous acceptez les termes révisés.",
  "@section6Text": {
    "description": "Texte de la section 6"
  },

